{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "reportUnusedDisableDirectives": true,
  "overrides": [
    {
      "files": ["app/**/*.{ts,tsx}", "components/**/*.{ts,tsx}", "content/**/*.ts"],
      "rules": {
        "no-restricted-syntax": [
          "error",
          {
            "selector": "Literal[value=/^#(?:[0-9a-fA-F]{3,8})$/]",
            "message": "Use design token variables instead of raw hex values."
          },
          {
            "selector": "Literal[value=/^(?:rgba?|hsla?|oklch|oklab|lab|lch|color)\\(/]",
            "message": "Use design token variables instead of raw colour functions."
          }
        ]
      }
    }
  ]
}
