+      if (page.empty) break;
+
+      // A document whose server timestamp has not materialised yet is younger
+      // than any cutoff by definition, so it is left alone rather than handed to
+      // pruneExpired, which treats an illegible time as expired.
+      const rows = page.docs
+        .filter((doc) => !!doc.get("at"))
+        .map((doc) => ({ id: doc.id, at: doc.get("at").toDate().toISOString() }));
+      const { kept } = telemetry.pruneExpired(rows, now);
+      const keptIds = new Set(kept.map((row) => row.id));
+      const expired = rows.filter((row) => !keptIds.has(row.id));
+      if (expired.length === 0) break;
+
+      const batch = firestore.batch();
+      for (const row of expired) batch.delete(firestore.collection(RAW_EVENTS).doc(row.id));
+      await batch.commit();
+      deleted += expired.length;
+
+      if (page.size < 400) break;
     }
+
+    logger.info("telemetry prune complete", { deleted, retentionDays: telemetry.RETENTION_DAYS });
   },
 );
+
+/**
+ * Which topic a question was about, recorded as an index and never as words.
+ *
+ * The question itself is already leaving this origin — it is answered by a model
+ * at OpenRouter, and the notice on the page says so plainly — but it is never
+ * stored here and never joined to anything. `text` is a local string inside one
+ * invocation; what survives the call is one integer into
+ * `functions/lib/kb-topics.json`, which is generated from the site's own
+ * knowledge base so the taxonomy cannot drift away from it.
+ *
+ * A failure here is silent by design: a chat answer must never fail because a
+ * counter did not increment.
+ */
+async function recordChatTopic(text) {
+  try {
+    const index = telemetry.topicIndexFor(text, kbTopics.topics);
+    const event = telemetry.sanitiseEvent({
+      name: "chatbot-topic",
+      section: "listen",
+      value: index < 0 ? 0 : index + 1,
+      at: new Date().toISOString(),
+    });
+    await storeEvents([event]);
+  } catch (err) {
+    logger.error("telemetry topic write failed", { code: err && err.code ? err.code : "unknown" });
+  }
+}
+
+exports.recordChatTopic = recordChatTopic;
+
+/**
+ * Wire the conversational layer to this file's Firestore handle and to the
+ * topic counter, now that both exist.
+ *
+ * The rate-limit store is injected rather than reached for, so the same handler
+ * can be run against an in-process store by `npm run chat:serve` and probed by
+ * the grounding battery without a deploy. `onQuestion` keeps the R-87 claim
+ * true: the page says it counts which knowledge-base topic a question was
+ * about, and this is the call that makes that sentence true. What survives is
+ * one integer; the question itself is never stored.
+ */
+chat.configure({
+  store: chatRatelimit.firestoreStore(db()),
+  onQuestion: recordChatTopic,
+});
