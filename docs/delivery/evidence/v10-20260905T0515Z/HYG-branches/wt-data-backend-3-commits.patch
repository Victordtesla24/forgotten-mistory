--- /dev/null
+++ b/tests/telemetry/collector.contract.mjs
@@ -0,0 +1,334 @@
+/**
+ * Collector contract — the pure logic behind the first-party telemetry Cloud
+ * Function (R-87 collection, R-88 aggregation, R-175 failure path).
+ *
+ * Run:  node --test tests/telemetry/collector.contract.mjs
+ *
+ * These assert values, not symbols. Every expected number below was computed by
+ * hand from the fixture immediately above it, so a change in the aggregation
+ * that still "returns a number" fails here.
+ *
+ * The subject is `functions/lib/telemetry.js` — deliberately a plain CommonJS
+ * module with no firebase-functions import, so the collector's decisions about
+ * what it will accept, what it strips, how long it keeps anything and what it
+ * concludes are testable without deploying or emulating anything.
+ */
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { dirname, resolve } from 'node:path';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const SUBJECT = resolve(HERE, '../../functions/lib/telemetry.js');
+const require_ = createRequire(import.meta.url);
+
+/** Load the subject, failing the individual test with a legible reason rather
+ *  than aborting the whole file on a missing module. */
+function collector() {
+  try {
+    return require_(SUBJECT);
+  } catch (err) {
+    assert.fail(
+      `functions/lib/telemetry.js could not be loaded — the first-party telemetry ` +
+        `collector does not exist yet. R-87 requires it. Underlying error: ${err.message}`,
+    );
+  }
+}
+
+/** The nine dimensions R-87 enumerates. */
+const EXPECTED_EVENTS = [
+  'dwell',
+  'scroll-depth',
+  'drop-off',
+  'carousel-depth',
+  'chatbot-session',
+  'chatbot-topic',
+  'avatar-play',
+  'avatar-complete',
+  'conversion',
+];
+
+/** After sanitisation an event may carry exactly these four keys and no others. */
+const SANITISED_KEYS = ['at', 'name', 'section', 'value'];
+
+/** Anything that could name, follow or fingerprint a visitor. Asserted absent
+ *  from every sanitised event and from every aggregate, recursively. */
+const IDENTIFYING_KEYS = [
+  'ip',
+  'ipAddress',
+  'ua',
+  'userAgent',
+  'visitorId',
+  'sessionId',
+  'clientId',
+  'cid',
+  'uid',
+  'email',
+  'referrer',
+  'query',
+  'text',
+  'question',
+  'lang',
+  'language',
+  'timezone',
+  'tz',
+  'screen',
+  'fingerprint',
+  'cookie',
+];
+
+function collectKeysDeep(value, acc = new Set()) {
+  if (Array.isArray(value)) {
+    for (const v of value) collectKeysDeep(v, acc);
+  } else if (value && typeof value === 'object') {
+    for (const [k, v] of Object.entries(value)) {
+      acc.add(k);
+      collectKeysDeep(v, acc);
+    }
+  }
+  return acc;
+}
+
+describe('TEL-COLLECT: what the collector will accept', () => {
+  test('TEL-COLLECT-01: ACCEPTED_EVENTS is exactly the nine R-87 dimensions, in order', () => {
+    const { ACCEPTED_EVENTS } = collector();
+    assert.deepStrictEqual([...ACCEPTED_EVENTS], EXPECTED_EVENTS);
+  });
+
+  test('TEL-COLLECT-02: an envelope with no events array is rejected as events_required', () => {
+    const { validateEnvelope } = collector();
+    assert.deepStrictEqual(validateEnvelope({}), { ok: false, error: 'events_required' });
+    assert.deepStrictEqual(validateEnvelope({ events: 'dwell' }), { ok: false, error: 'events_required' });
+    assert.deepStrictEqual(validateEnvelope({ events: [] }), { ok: false, error: 'events_required' });
+  });
+
+  test('TEL-COLLECT-03: an event name outside the nine is rejected as unknown_event', () => {
+    const { validateEnvelope } = collector();
+    const out = validateEnvelope({
+      events: [{ name: 'pageview', section: 'hero', value: 1, at: '2026-09-03T21:00:00Z' }],
+    });
+    assert.deepStrictEqual(out, { ok: false, error: 'unknown_event' });
+  });
+
+  test('TEL-COLLECT-04: an oversized envelope is rejected as too_many_events', () => {
+    const { validateEnvelope, MAX_EVENTS_PER_ENVELOPE } = collector();
+    assert.equal(typeof MAX_EVENTS_PER_ENVELOPE, 'number');
+    const one = { name: 'dwell', section: 'hero', value: 1000, at: '2026-09-03T21:00:00Z' };
+    const events = Array.from({ length: MAX_EVENTS_PER_ENVELOPE + 1 }, () => ({ ...one }));
+    assert.deepStrictEqual(validateEnvelope({ events }), { ok: false, error: 'too_many_events' });
+  });
+
+  test('TEL-COLLECT-05: a chatbot topic must arrive as a topic index, never as the visitor’s words', () => {
+    const { validateEnvelope } = collector();
+    const out = validateEnvelope({
+      events: [
+        {
+          name: 'chatbot-topic',
+          section: 'listen',
+          value: 'how many years of experience does Vikram have',
+          at: '2026-09-03T21:00:00Z',
+        },
