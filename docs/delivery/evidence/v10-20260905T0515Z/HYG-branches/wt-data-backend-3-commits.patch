+ * ======================================================================== */
+
+heading('G · per-visualisation dossiers (R-112)');
+
+check('G1', 'app/data/canonical/dossiers.ts exists and registers at least one dossier per section', () => {
+  const path = join(CANON, 'dossiers.ts');
+  const src = readTextOrFail(path);
+  const sections = ['#hero', '#about', '#experience', '#skills', '#vitrine', '#listen'];
+  const missing = sections.filter((s) => !src.includes(s));
+  if (missing.length) fail(`no dossier registered for: ${missing.join(', ')}`);
+  return true;
+});
+
+check('G2', 'every dossier declares the full R-112 format, with a takeaway of at most 20 words', () => {
+  const src = readTextOrFail(join(CANON, 'dossiers.ts'));
+  for (const member of [
+    'vizId', 'section', 'renderClass', 'whatItShows', 'datasetFields', 'goldMark',
+    'interactions', 'demonstratedSkill', 'takeaway', 'accessibility', 'performance',
+  ]) {
+    if (!src.includes(member)) fail(`the dossier registry never mentions "${member}"`);
+  }
+  const takeaways = [...src.matchAll(/takeaway:\s*'([^']*)'/g)].map((m) => m[1]);
+  if (!takeaways.length) fail('no dossier declares a takeaway');
+  const tooLong = takeaways.filter((t) => t.trim().split(/\s+/).length > 20);
+  if (tooLong.length) fail(`${tooLong.length} takeaways exceed 20 words (R-99)`);
+  return true;
+});
+
+check('G3', 'dossier performance figures are measured, not authored — reports/viz-perf.json backs each one', () => {
+  const perfPath = join(ROOT, 'reports', 'viz-perf.json');
+  if (!existsSync(perfPath)) fail('reports/viz-perf.json does not exist; a model may never produce a quantitative mark (R-111)');
+  const perf = readJson(perfPath);
+  const src = readTextOrFail(join(CANON, 'dossiers.ts'));
+  const vizIds = [...src.matchAll(/vizId:\s*'([^']+)'/g)].map((m) => m[1]);
+  if (!vizIds.length) fail('no vizId declared in the registry');
+  const unmeasured = vizIds.filter((id) => !(id in perf) && !(Array.isArray(perf) && perf.some((r) => r.vizId === id)));
+  if (unmeasured.length) fail(`no measurement recorded for: ${unmeasured.join(', ')}`);
+  return true;
+});
+
+/* ==========================================================================
+ * H · R-183 — the self-claim and the implementation move together
+ * ======================================================================== */
+
+heading('H · self-claim coherence (R-183, T-40)');
+
+guard('H1', 'GUARD: the site must never claim figures are "not computed live" while the build refreshes them', () => {
+  const vitrine = readTextOrFail(join(ROOT, 'app', 'data', 'portfolio', 'vitrine.ts'));
+  const claimsNotLive = /none is computed live|not live|harvested once/i.test(vitrine);
+  const buildRefreshes = (pkg.scripts['build:static'] || '').includes('dataset:refresh');
+  if (buildRefreshes && claimsNotLive) {
+    fail('build:static now refreshes the dataset but the vitrine still tells the reader nothing is computed live (R-183 violation)');
+  }
+  return true;
+});
+
+check('H2', 'the date on the page is the date in the data — harvestedAt reads from the manifest', () => {
+  const vitrine = readTextOrFail(join(ROOT, 'app', 'data', 'portfolio', 'vitrine.ts'));
+  if (/harvest\.harvestedAt/.test(vitrine)) {
+    fail('vitrine reads harvestedAt from the hand-run repo-harvest.json, so the page date can drift from the data');
+  }
+  if (!/manifest|oldestRetrievedAt|currency\(/.test(vitrine)) {
+    fail('vitrine does not read its currency line from the dataset manifest');
+  }
+  return true;
+});
+
+/* ============================================================ kernel behaviour */
+
+async function kernelBehaviour() {
+  heading('A · provenance kernel — behaviour');
+  let mod = null;
+  try {
+    if (kernelTmp && existsSync(join(kernelTmp, 'provenance.js'))) {
+      mod = await import(pathToFileURL(join(kernelTmp, 'provenance.js')).href);
+    }
+  } catch (error) {
+    mod = null;
+    results.push({ id: 'A-import', group: 'A · provenance kernel', description: 'the compiled kernel imports', ok: false, detail: String(error && error.message) });
+  }
+
+  const need = () => {
+    if (!mod) fail('the provenance kernel does not exist, so its behaviour cannot be exercised');
+    return mod;
+  };
+
+  check('A6', 'sourced(v, p) returns { kind: "sourced", value: v, provenance: p }', () => {
+    const m = need();
+    const p = { source: 'github-rest', retrievedAt: '2026-09-03T20:11:00Z', method: 'GET /user/repos', url: 'https://api.github.com/user/repos' };
+    const f = m.sourced(38, p);
+    eq(f.kind, 'sourced', 'sourced().kind');
+    eq(f.value, 38, 'sourced().value');
+    eq(f.provenance.retrievedAt, p.retrievedAt, 'sourced().provenance.retrievedAt');
+    return true;
+  });
+
+  check('A7', 'notObservable(reason, provedBy, p) carries a null value, the reason and the proving command', () => {
+    const m = need();
+    const p = { source: 'linkedin-public', retrievedAt: '2026-09-03T20:00:00Z', method: 'GET /in/vikramd-profile', url: null };
+    const f = m.notObservable('auth-walled: HTTP 999', 'curl -s -o /dev/null -w %{http_code} https://www.linkedin.com/in/vikramd-profile', p);
+    eq(f.kind, 'not-observable', 'notObservable().kind');
+    eq(f.value, null, 'notObservable().value');
+    if (!f.reason || !f.provedBy) fail('reason and provedBy did not survive the constructor');
+    return true;
+  });
+
+  check('A8', 'must() throws — never returns 0, "" or undefined — for a not-observable field (R-175)', () => {
+    const m = need();
+    const p = { source: 'youtube-web', retrievedAt: '2026-09-03T20:08:39Z', method: 'ytInitialData', url: null };
+    const f = m.notObservable('transcript is bot-gated', 'playabilityStatus=LOGIN_REQUIRED', p);
+    let threw = false;
+    let returned;
+    try { returned = m.must(f, 'channel.videos[0].transcript'); } catch { threw = true; }
+    if (!threw) fail(`must() returned ${JSON.stringify(returned)} instead of throwing; a silent default is exactly the zero R-175 forbids`);
+    return true;
+  });
+
+  check('A9', 'isObservable narrows: true for sourced, false for not-observable', () => {
+    const m = need();
+    const p = { source: 'cv-pdf', retrievedAt: '2026-09-03T19:59:00Z', method: 'md5 of the PDF bytes', url: null };
+    if (m.isObservable(m.sourced('x', p)) !== true) fail('isObservable(sourced) is not true');
+    if (m.isObservable(m.notObservable('r', 'c', p)) !== false) fail('isObservable(notObservable) is not false');
+    return true;
+  });
+
+  check('A10', 'envelope.ts declares all four RefreshOutcome states and a RefreshRecord that records failure', () => {
+    const src = readTextOrFail(ENVELOPE_TS);
+    for (const state of ['fresh', 'partial', 'retained', 'static']) {
+      if (!new RegExp(`'${state}'`).test(src)) fail(`RefreshOutcome is missing the "${state}" state`);
+    }
+    for (const member of ['attemptedAt', 'outcome', 'command', 'fieldsFresh', 'fieldsRetained', 'failure']) {
+      if (!src.includes(member)) fail(`RefreshRecord is missing "${member}"`);
+    }
+    for (const member of ['datasetVersion', 'valueHash', 'recordHash']) {
+      if (!src.includes(member)) fail(`the envelope never declares "${member}" (T-37 diffability)`);
+    }
+    return true;
+  });
+
+  if (kernelTmp) rmSync(kernelTmp, { recursive: true, force: true });
+}
+
+/* --------------------------------------------------------------- reporting */
+
+await kernelBehaviour();
+
+const report = results;
+
+const failed = report.filter((r) => !r.ok);
+const passed = report.filter((r) => r.ok);
+
+let lastGroup = '';
+for (const r of report) {
+  if (r.group !== lastGroup) {
+    lastGroup = r.group;
+    console.log(`\n${lastGroup}`);
+  }
+  const flag = r.ok ? (r.guard ? 'PASS (guard)' : 'PASS') : 'FAIL';
+  console.log(`  [${flag}] ${r.id}  ${r.description}`);
+  if (!r.ok && r.detail) {
+    for (const line of String(r.detail).split('\n')) console.log(`           ${line}`);
+  }
+}
+
+console.log(`\n${'-'.repeat(78)}`);
+console.log(`dataset canonical contract: ${passed.length} passed, ${failed.length} FAILED, ${report.length} assertions`);
+if (failed.length) {
+  console.log(`failing: ${failed.map((r) => r.id).join(', ')}`);
+  process.exit(1);
+}
+console.log('ALL PASS');
