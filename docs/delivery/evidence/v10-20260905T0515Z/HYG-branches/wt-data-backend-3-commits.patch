--- /dev/null
+++ b/tests/grounding/retrieval_unit.contract.mjs
@@ -0,0 +1,335 @@
+/**
+ * The retrieval and validation primitives, off Firebase.
+ *
+ * Run:  node --test tests/grounding/retrieval_unit.contract.mjs
+ *
+ * Contract: SPEC-chatbot-uplift.md §2.5, §2.6, §3.4, §4.3 · R-66, R-111, R-131.
+ *
+ * Subjects are plain CommonJS modules with no firebase-functions import, so the
+ * scorer's arithmetic, the tokenizer's decisions, the sentence gate and the three
+ * validators are testable without deploying or emulating anything.
+ *
+ * Every expected number below was computed by hand from the constants in §2.6 and
+ * is written out as a literal. A scorer that "returns a number" fails here.
+ */
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { dirname, resolve } from 'node:path';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(HERE, '../..');
+const require_ = createRequire(import.meta.url);
+
+function subject(rel, why) {
+  const path = resolve(ROOT, rel);
+  try {
+    return require_(path);
+  } catch (err) {
+    assert.fail(`${rel} could not be loaded — ${why}. Underlying error: ${err.message}`);
+  }
+}
+
+const load = {
+  config: () => subject('functions/chat/config.js', 'R-66 needs one place for every tunable constant'),
+  tokenize: () => subject('functions/chat/tokenize.js', 'the tokenizer is shared by the build script and the function'),
+  bm25: () => subject('functions/chat/bm25.js', 'BM25F is the retrieval strategy chosen over embeddings (§2.1)'),
+  sentences: () => subject('functions/chat/sentences.js', 'streaming is sentence-gated so nothing unvalidated reaches a viewer'),
+  validate: () => subject('functions/chat/validate.js', 'V-1/V-2/V-3 are the backstop that makes injection unable to fabricate'),
+  retrieve: () => subject('functions/chat/retrieve.js', 'the in-corpus gate is what turns R-67 into a mechanism'),
+  prompt: () => subject('functions/chat/prompt.js', 'the ONLY place a system prompt exists'),
+};
+
+describe('§2.6 · the constants are in one file and are the calibrated ones', () => {
+  test('RET-CFG-01: every tunable is exported from functions/chat/config.js', () => {
+    const c = load.config();
+    assert.equal(c.K1, 1.2);
+    assert.deepEqual(c.FIELD_WEIGHT, { title: 3.0, terms: 2.5, text: 1.0 });
+    assert.deepEqual(c.FIELD_B, { title: 0.55, terms: 0.0, text: 0.62 });
+    assert.equal(c.ALIAS_WEIGHT, 0.6);
+    assert.equal(c.TOP_K, 8);
+    assert.equal(c.SCORE_FLOOR_RATIO, 0.45);
+    assert.equal(c.MMR_LAMBDA, 0.7);
+    assert.equal(c.CONTEXT_CHAR_CAP, 6000);
+    assert.equal(c.MAX_QUESTION_CHARS, 600);
+    assert.equal(c.MAX_HISTORY_TURNS, 8);
+    assert.equal(c.MAX_HISTORY_CHARS, 3000);
+  });
+
+  test('RET-CFG-02: FIELD_B.terms is exactly 0 — curated keys, so length is not evidence', () => {
+    assert.equal(load.config().FIELD_B.terms, 0);
+  });
+
+  test('RET-CFG-03: the two gate thresholds exist and are finite', () => {
+    const c = load.config();
+    assert.ok(
+      Number.isFinite(c.IN_CORPUS_MIN_SCORE) && c.IN_CORPUS_MIN_SCORE > 0,
+      `IN_CORPUS_MIN_SCORE decides whether the bot speaks; it must be a real calibrated ` +
+        `number. got ${JSON.stringify(c.IN_CORPUS_MIN_SCORE)}`,
+    );
+    assert.ok(
+      Number.isFinite(c.IN_CORPUS_MIN_COVERAGE) && c.IN_CORPUS_MIN_COVERAGE > 0 && c.IN_CORPUS_MIN_COVERAGE <= 1,
+      `IN_CORPUS_MIN_COVERAGE must be a fraction. got ${JSON.stringify(c.IN_CORPUS_MIN_COVERAGE)}`,
+    );
+  });
+});
+
+describe('§2.5 · the tokenizer', () => {
+  test('RET-TOK-01: stop words go, and negation stays — negation is meaning here', () => {
+    const { tokenize } = load.tokenize();
+    assert.deepEqual(tokenize('the CI is not passing', new Map()), ['ci', 'not', 'passing']);
+  });
+
+  test('RET-TOK-02: one-character tokens go unless they are in KEEP_SHORT', () => {
+    const { tokenize } = load.tokenize();
+    assert.deepEqual(tokenize('R and C and x', new Map()), ['r', 'c']);
+  });
+
+  test('RET-TOK-03: + and # survive, so c++ and c# are not mangled', () => {
+    const { tokenize } = load.tokenize();
+    assert.deepEqual(tokenize('c++ and c#', new Map()), ['c++', 'c#']);
+  });
+
+  test('RET-TOK-04: diacritics are folded', () => {
+    const { tokenize } = load.tokenize();
+    assert.deepEqual(tokenize('Prajñya', new Map()), ['prajnya']);
