+++ b/scripts/validate/dataset_offline_refresh.mjs
@@ -0,0 +1,301 @@
+/**
+ * dataset_offline_refresh.mjs — proves the failure path of the deploy-time
+ * refresh (R-175, R-182, dataset-layer-design.md §3.4).
+ *
+ * WRITTEN BEFORE THE IMPLEMENTATION EXISTS.
+ *
+ * The claim under test: "When an API is unreachable at build time, a
+ * stale-but-true value with an honest retrievedAt is CORRECT; an invented value
+ * or a zero is forbidden."
+ *
+ * The network is severed for real — the refresh runs inside an unshared network
+ * namespace (`unshare -rn`) with nothing but loopback — so api.github.com and
+ * youtube.com are genuinely unreachable. Nothing here is mocked, and there is no
+ * DATASET_FORCE_OFFLINE style back door for the implementation to special-case.
+ *
+ * The committed dataset is backed up before the run and restored afterwards, so
+ * this script leaves the tree exactly as it found it.
+ *
+ * Usage:  node scripts/validate/dataset_offline_refresh.mjs
+ * Exit:   0 only when every assertion holds; non-zero with the reason otherwise.
+ *         It never skips: if the network cannot be severed, that is a FAILURE to
+ *         run the test, not a pass.
+ */
+import { execFileSync } from 'node:child_process';
+import { cpSync, existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..', '..');
+const GEN = join(ROOT, 'app', 'data', 'canonical', 'generated');
+const MODULE_IDS = ['cv', 'linkedin', 'repositories', 'channel', 'delivery'];
+const NETWORK_MODULES = ['repositories', 'channel'];
+const SECRET_SHAPES = [/gh[pousr]_[A-Za-z0-9]{16,}/, /\bsk-[A-Za-z0-9]{16,}/, /\bAIza[0-9A-Za-z_-]{20,}/];
+const PLACEHOLDERS = new Set(['', 'N/A', 'n/a', '—', '-', 'TBD', 'null', 'undefined', 'NaN']);
+
+const results = [];
+function check(id, description, fn) {
+  try {
+    const outcome = fn();
+    results.push({ id, description, ok: outcome !== false, detail: '' });
+  } catch (error) {
+    results.push({ id, description, ok: false, detail: error?.message ?? String(error) });
+  }
+}
+function fail(message) { throw new Error(message); }
+
+function readJson(path) {
+  if (!existsSync(path)) fail(`missing file: ${path.replace(`${ROOT}/`, '')}`);
+  return JSON.parse(readFileSync(path, 'utf8'));
+}
+
+const FIELD_KINDS = new Set(['sourced', 'not-observable']);
+function collectFields(node, path, out) {
+  if (Array.isArray(node)) {
+    node.forEach((item, i) => collectFields(item, `${path}[${i}]`, out));
+    return out;
+  }
+  if (node && typeof node === 'object') {
+    if (typeof node.kind === 'string' && FIELD_KINDS.has(node.kind)) {
+      out.push({ path, field: node });
+      collectFields(node.value, `${path}.value`, out);
+      return out;
+    }
+    for (const [key, value] of Object.entries(node)) {
+      collectFields(value, path ? `${path}.${key}` : key, out);
+    }
+  }
+  return out;
+}
+
+function fieldMap(moduleRecord) {
+  const map = new Map();
+  for (const { path, field } of collectFields(moduleRecord.data, '', [])) map.set(path, field);
+  return map;
+}
+
+/* ------------------------------------------------------------ preconditions */
+
+check('O1', 'the network can genuinely be severed with `unshare -rn` (the test must not be mockable)', () => {
+  let severed = false;
+  try {
+    const out = execFileSync(
+      'unshare',
+      ['-rn', 'sh', '-c', 'curl -sS -m 5 https://api.github.com/ -o /dev/null -w %{http_code} 2>&1 || echo DENIED'],
+      { encoding: 'utf8', timeout: 30000 },
+    );
+    severed = /DENIED|Could not resolve|000/.test(out);
+  } catch {
+    severed = true; // unshare itself refusing to reach the network is the condition we want
+  }
+  if (!severed) fail('`unshare -rn` still reached api.github.com; this host cannot prove the offline path');
+  return true;
+});
+
+check('O2', 'the canonical dataset exists to be refreshed', () => {
+  const missing = [...MODULE_IDS.map((m) => `${m}.v1.json`), 'manifest.v1.json']
+    .filter((n) => !existsSync(join(GEN, n)));
+  if (missing.length) fail(`app/data/canonical/generated/ is missing: ${missing.join(', ')}`);
+  return true;
+});
+
+check('O3', 'scripts/dataset/build_dataset.mjs exists to run', () => {
+  if (!existsSync(join(ROOT, 'scripts', 'dataset', 'build_dataset.mjs'))) {
+    fail('scripts/dataset/build_dataset.mjs does not exist');
+  }
+  return true;
+});
+
+/* ------------------------------------------------------------- the offline run */
+
+const canProceed = results.every((r) => r.ok);
+let before = null;
+let after = null;
+let refreshExit = null;
+let refreshOutput = '';
+let backup = null;
+
+if (canProceed) {
+  backup = mkdtempSync(join(tmpdir(), 'fm-dataset-backup-'));
+  cpSync(GEN, backup, { recursive: true });
+  before = Object.fromEntries(MODULE_IDS.map((m) => [m, readJson(join(GEN, `${m}.v1.json`))]));
+  before.manifest = readJson(join(GEN, 'manifest.v1.json'));
+
+  try {
+    refreshOutput = execFileSync(
+      'unshare',
+      ['-rn', 'node', join(ROOT, 'scripts', 'dataset', 'build_dataset.mjs')],
+      {
+        cwd: ROOT,
+        encoding: 'utf8',
+        timeout: 300000,
+        stdio: ['ignore', 'pipe', 'pipe'],
+        env: { ...process.env, YTDLP_BIN: '/nonexistent/yt-dlp' },
+      },
+    );
+    refreshExit = 0;
+  } catch (error) {
+    refreshExit = error.status ?? 1;
+    refreshOutput = `${error.stdout ?? ''}${error.stderr ?? ''}`;
+  }
+
+  after = Object.fromEntries(MODULE_IDS.map((m) => [m, readJson(join(GEN, `${m}.v1.json`))]));
+  after.manifest = readJson(join(GEN, 'manifest.v1.json'));
+}
+
+function needRun() {
+  if (!canProceed) fail('the offline refresh could not be run — see the failures above');
+  return true;
+}
+
+check('O4', 'a refresh with the APIs unreachable exits 0 — a degraded refresh is a normal build, not a failed one', () => {
+  needRun();
+  if (refreshExit !== 0) {
+    fail(`build_dataset.mjs exited ${refreshExit} offline.\n      output: ${refreshOutput.slice(0, 800)}`);
+  }
+  return true;
+});
+
+check('O5', 'the network-backed modules record outcome "retained", not "fresh"', () => {
+  needRun();
+  const bad = NETWORK_MODULES
+    .map((m) => [m, after[m].refresh.outcome])
+    .filter(([, outcome]) => outcome !== 'retained');
+  if (bad.length) fail(bad.map(([m, o]) => `${m} claims outcome "${o}" with no network`).join('; '));
+  return true;
+});
+
+check('O6', 'the CV module still refreshes offline — it reads local bytes and its outcome is "static"', () => {
+  needRun();
+  if (after.cv.refresh.outcome !== 'static') {
+    fail(`cv outcome is "${after.cv.refresh.outcome}"; the CV is local bytes and must not depend on the network`);
+  }
+  return true;
+});
+
+check('O7', 'EVERY previously sourced field survives byte-identically — same value AND its ORIGINAL retrievedAt', () => {
+  needRun();
+  const bad = [];
+  for (const id of NETWORK_MODULES) {
+    const wasMap = fieldMap(before[id]);
+    const isMap = fieldMap(after[id]);
+    for (const [path, was] of wasMap) {
+      if (was.kind !== 'sourced') continue;
+      const is = isMap.get(path);
+      if (!is) { bad.push(`${id}${path}: field DISAPPEARED (preservation loss)`); continue; }
+      if (JSON.stringify(is) !== JSON.stringify(was)) {
+        bad.push(
+          `${id}${path}: changed with no network — was ${JSON.stringify(was.value)} @ ${was.provenance?.retrievedAt}, ` +
+            `now ${JSON.stringify(is.value)} @ ${is.provenance?.retrievedAt}`,
+        );
+      }
+    }
+  }
+  if (bad.length) fail(`${bad.length} retained fields were not retained:\n      ${bad.slice(0, 10).join('\n      ')}`);
+  return true;
+});
+
+check('O8', 'no field degraded to a zero, a null or a placeholder (R-175)', () => {
+  needRun();
+  const bad = [];
+  for (const id of MODULE_IDS) {
+    const wasMap = fieldMap(before[id]);
+    for (const [path, was] of fieldMap(after[id])) {
+      if (was.kind !== 'sourced') continue;
+      const v = was.value;
+      const hadValue = wasMap.get(path)?.kind === 'sourced';
+      if (typeof v === 'number' && v === 0 && was.zeroIsMeaningful !== true) bad.push(`${id}${path} = 0`);
+      if (v === null || v === undefined) bad.push(`${id}${path} = ${String(v)}`);
+      if (typeof v === 'string' && PLACEHOLDERS.has(v.trim())) bad.push(`${id}${path} = ${JSON.stringify(v)}`);
+      if (hadValue && Array.isArray(v) && v.length === 0) bad.push(`${id}${path} = [] (was populated)`);
+    }
+  }
+  if (bad.length) fail(bad.slice(0, 12).join('; '));
+  return true;
+});
+
+check('O9', 'the failure is recorded honestly — refresh.failure carries a real exit code or HTTP status and a detail', () => {
+  needRun();
+  const bad = [];
+  for (const id of NETWORK_MODULES) {
+    const f = after[id].refresh.failure;
+    if (!f) { bad.push(`${id}: refresh.failure is null after a total network failure`); continue; }
+    if (f.exitCode === null && f.httpStatus === null) bad.push(`${id}: neither exitCode nor httpStatus recorded`);
+    if (!f.detail || String(f.detail).trim().length < 4) bad.push(`${id}: failure.detail is empty`);
+  }
+  if (bad.length) fail(bad.join('; '));
+  return true;
+});
+
+check('O10', 'refresh.command names its secrets by VARIABLE NAME — no token value is ever written to a file', () => {
+  needRun();
+  const bad = [];
+  for (const id of MODULE_IDS) {
+    const command = String(after[id].refresh.command ?? '');
+    for (const shape of SECRET_SHAPES) {
+      if (shape.test(command)) bad.push(`${id}.refresh.command leaks a secret matching ${shape}`);
+    }
+  }
+  for (const name of readdirSync(GEN)) {
+    const text = readFileSync(join(GEN, name), 'utf8');
+    for (const shape of SECRET_SHAPES) if (shape.test(text)) bad.push(`${name} contains a secret matching ${shape}`);
+  }
+  if (bad.length) fail(bad.join('; '));
+  return true;
+});
+
+check('O11', 'datasetVersion does NOT increment when nothing was re-observed (T-37: "we looked again" is not "the data moved")', () => {
+  needRun();
+  const wasVersion = before.manifest.datasetVersion;
+  const isVersion = after.manifest.datasetVersion;
+  if (isVersion !== wasVersion) {
+    fail(`datasetVersion moved ${wasVersion} -> ${isVersion} on a refresh that observed nothing new`);
+  }
+  for (const id of NETWORK_MODULES) {
+    if (after[id].valueHash !== before[id].valueHash) {
+      fail(`${id}.valueHash changed with no network; the values cannot have moved`);
+    }
+  }
+  return true;
+});
+
+check('O12', 'the manifest still prints the ORIGINAL observation date, so the page cannot claim false freshness', () => {
+  needRun();
+  for (const id of NETWORK_MODULES) {
+    const wasRow = before.manifest.modules[id];
+    const isRow = after.manifest.modules[id];
+    if (isRow.oldestRetrievedAt !== wasRow.oldestRetrievedAt || isRow.newestRetrievedAt !== wasRow.newestRetrievedAt) {
+      fail(
+        `${id}: manifest dates moved on a retained refresh — ` +
+          `${wasRow.oldestRetrievedAt}..${wasRow.newestRetrievedAt} became ${isRow.oldestRetrievedAt}..${isRow.newestRetrievedAt}`,
+      );
+    }
+    if (isRow.outcome !== 'retained') fail(`${id}: manifest outcome is "${isRow.outcome}", not "retained"`);
+  }
+  return true;
+});
+
+/* ------------------------------------------------------------------ restore */
+
+if (backup) {
+  rmSync(GEN, { recursive: true, force: true });
+  cpSync(backup, GEN, { recursive: true });
+  rmSync(backup, { recursive: true, force: true });
+}
+
+/* ---------------------------------------------------------------- reporting */
+
+console.log('\noffline deploy-time refresh — R-175 / R-182 failure path\n');
+for (const r of results) {
+  console.log(`  [${r.ok ? 'PASS' : 'FAIL'}] ${r.id}  ${r.description}`);
+  if (!r.ok && r.detail) for (const line of String(r.detail).split('\n')) console.log(`           ${line}`);
+}
+const failed = results.filter((r) => !r.ok);
+console.log(`\n${'-'.repeat(78)}`);
+console.log(`offline refresh: ${results.length - failed.length} passed, ${failed.length} FAILED, ${results.length} assertions`);
+if (failed.length) {
+  console.log(`failing: ${failed.map((r) => r.id).join(', ')}`);
+  process.exit(1);
+}
+console.log('ALL PASS');
diff --git a/tests/content/dataset_marks.spec.ts b/tests/content/dataset_marks.spec.ts
