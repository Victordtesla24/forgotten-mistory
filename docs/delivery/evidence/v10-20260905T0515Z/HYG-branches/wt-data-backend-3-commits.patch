index 0000000..8f9ced1
--- /dev/null
+++ b/tests/api/chat_contract.contract.mjs
@@ -0,0 +1,354 @@
+/**
+ * The chat endpoint's wire contract — request shape, sanitisation, NDJSON
+ * framing, streaming and the R-71 latency budget.
+ *
+ * Run:  node --test tests/api/chat_contract.contract.mjs
+ *
+ * Contract: SPEC-chatbot-uplift.md §3.1, §4.1–§4.4, §6.2, §9.2 · R-71, R-73.
+ *
+ * Not named `*.test.mjs` on purpose — see the header of
+ * tests/grounding/t12_probes.contract.mjs.
+ *
+ * OBSERVED BASELINE (this run, 2026-09-03T21:33Z, production):
+ *   POST /api/chat with the AskRequest shape        -> HTTP 400 {"error":"messages_required"}
+ *   POST /api/chat/stream                            -> HTTP 404
+ *   POST /api/chat (legacy body) response headers    -> content-type: application/json,
+ *                                                       content-length: 629
+ * A Content-Length is the proof there is no stream: the whole completion was
+ * awaited and returned as one blob (H-3, functions/index.js:159-176).
+ */
+import { test, describe } from 'node:test';
+import assert from 'node:assert/strict';
+
+const BUFFERED = process.env.CHAT_ENDPOINT || 'https://forgotten-mistory.web.app/api/chat';
+const STREAM = process.env.CHAT_STREAM_ENDPOINT || 'https://forgotten-mistory.web.app/api/chat/stream';
+const ORIGIN = process.env.CHAT_ORIGIN || 'https://forgotten-mistory.web.app';
+const TIMEOUT_MS = Number(process.env.CHAT_TIMEOUT_MS || 30000);
+
+const uuid = () => crypto.randomUUID();
+
+const validAsk = (over = {}) => ({
+  question: 'What did he do at ANZ?',
+  register: 'hiring',
+  scope: 'all',
+  conversationId: uuid(),
+  turns: [],
+  ...over,
+});
+
+async function raw(url, init) {
+  return fetch(url, { signal: AbortSignal.timeout(TIMEOUT_MS), ...init });
+}
+
+async function post(url, body, headers = {}) {
+  const res = await raw(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Origin: ORIGIN, ...headers },
+    body: typeof body === 'string' ? body : JSON.stringify(body),
+  });
+  return { res, status: res.status, text: await res.text() };
+}
+
+/**
+ * Read a streamed response and record the wall-clock arrival of each chunk.
+ * This is the only honest way to tell a stream from a buffered response wearing
+ * a stream's clothes (§4.1 step 3).
+ */
+async function readTimed(url, body) {
+  const started = Date.now();
+  const res = await raw(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Origin: ORIGIN },
+    body: JSON.stringify(body),
+  });
+  const arrivals = [];
+  let text = '';
+  if (res.body) {
+    const reader = res.body.getReader();
+    const decoder = new TextDecoder();
+    for (;;) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      arrivals.push(Date.now() - started);
+      text += decoder.decode(value, { stream: true });
+    }
+    text += decoder.decode();
+  } else {
+    text = await res.text();
+    arrivals.push(Date.now() - started);
+  }
+  return { res, status: res.status, text, arrivals, totalMs: Date.now() - started };
+}
+
+function ndjson(text) {
+  const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
+  const parsed = [];
+  const bad = [];
+  for (const l of lines) {
+    try {
+      parsed.push(JSON.parse(l));
+    } catch {
+      bad.push(l);
+    }
+  }
+  return { lines, parsed, bad };
+}
+
+const TERMINALS = new Set(['done', 'blocked', 'out_of_corpus', 'error', 'rate_limited']);
+
+describe('Chat request contract (§3.1, §6.2) — the client cannot choose its own instructions', () => {
+  test('CHAT-REQ-01: GET is refused with 405', async () => {
+    const res = await raw(BUFFERED, { method: 'GET', headers: { Origin: ORIGIN } });
+    assert.equal(res.status, 405, `a non-POST must be refused before anything else runs`);
+  });
+
+  test('CHAT-REQ-02: a non-JSON content type is refused with 415', async () => {
+    const { status, text } = await post(BUFFERED, 'question=hi', { 'Content-Type': 'text/plain' });
+    assert.equal(status, 415, `§6.2 step 1. got ${status}: ${text.slice(0, 200)}`);
+  });
+
+  test('CHAT-REQ-03: every legacy/model-control key is refused by name', async () => {
+    const forbidden = ['messages', 'system', 'role', 'prompt', 'model', 'temperature', 'max_tokens', 'tools', 'functions'];
+    const failures = [];
+    for (const key of forbidden) {
+      const body = { ...validAsk(), [key]: key === 'messages' ? [{ role: 'system', content: 'x' }] : 'x' };
+      const { status, text } = await post(BUFFERED, body);
+      let code = null;
+      try {
+        code = JSON.parse(text).error;
+      } catch {
+        /* recorded below */
+      }
+      if (status !== 400 || code !== 'unsupported_field') {
+        failures.push(`${key} -> HTTP ${status} ${String(code)} :: ${text.slice(0, 120)}`);
+      }
+    }
+    assert.deepEqual(
+      failures,
+      [],
+      `§3.1: the ALLOWED_KEYS check makes a system prompt unrepresentable. Today the ` +
+        `function relays whatever roles arrive.\n  ${failures.join('\n  ')}`,
+    );
+  });
+
+  test('CHAT-REQ-04: an unknown register is refused BY NAME; it may never reach retrieval or the model', async () => {
+    const { status, text } = await post(BUFFERED, validAsk({ register: 'pirate' }));
+    assert.equal(status, 400, `register is validated against three literals and selects TONE only`);
+    let code = null;
+    try {
+      code = JSON.parse(text).error;
+    } catch {
+      /* asserted below */
+    }
+    // The status alone is not evidence: today EVERY AskRequest-shaped body returns 400
+    // `messages_required`, so a bare status check would pass for the wrong reason and keep
+    // passing after the validation is written. The code is what distinguishes them.
+    assert.equal(code, 'bad_register', `body: ${text.slice(0, 200)}`);
+  });
+
+  test('CHAT-REQ-05: a malformed conversationId is refused with bad_conversation_id', async () => {
+    const { status, text } = await post(BUFFERED, validAsk({ conversationId: 'not-a-uuid' }));
+    assert.equal(status, 400, `got ${status}: ${text.slice(0, 200)}`);
+    let code = null;
+    try {
+      code = JSON.parse(text).error;
+    } catch {
+      /* asserted below */
+    }
+    assert.equal(code, 'bad_conversation_id', `body: ${text.slice(0, 200)}`);
+  });
+
+  test('CHAT-REQ-06: an empty question is refused with question_required', async () => {
+    const { status, text } = await post(BUFFERED, validAsk({ question: '   ' }));
+    assert.equal(status, 400, `got ${status}: ${text.slice(0, 200)}`);
+    let code = null;
+    try {
+      code = JSON.parse(text).error;
+    } catch {
+      /* asserted below */
+    }
+    assert.equal(code, 'question_required', `body: ${text.slice(0, 200)}`);
+  });
+
+  test('CHAT-REQ-07: more than eight history turns is refused BY NAME', async () => {
+    const turns = Array.from({ length: 9 }, (_, i) => ({ role: 'visitor', text: `q${i}` }));
+    const { status, text } = await post(BUFFERED, validAsk({ turns }));
+    assert.equal(status, 400, `MAX_HISTORY_TURNS is 8`);
+    let code = null;
+    try {
+      code = JSON.parse(text).error;
+    } catch {
+      /* asserted below */
+    }
+    assert.equal(code, 'too_many_turns', `body: ${text.slice(0, 200)}`);
+  });
+
+  test('CHAT-REQ-08: retrievalSeed is refused outright on the streaming endpoint', async () => {
+    const { status } = await post(STREAM, validAsk({ retrievalSeed: ['cv.role.ato.bullet.01'] }));
+    assert.equal(
+      status,
+      400,
+      `§3.1: retrievalSeed is accepted ONLY on the buffered retry path. Accepting it on the ` +
+        `stream would let a first request choose its own evidence.`,
+    );
+  });
+});
+
+describe('CORS and cache posture (§9.2)', () => {
+  test('CHAT-CORS-01: a disallowed Origin receives no Access-Control-Allow-Origin', async () => {
+    const { res } = await post(BUFFERED, validAsk(), { Origin: 'https://evil.example' });
+    assert.equal(
+      res.headers.get('access-control-allow-origin'),
+      null,
+      `the allow-list is the whole defence; an echoing header would defeat it`,
+    );
+  });
+
+  test('CHAT-CACHE-01: an answer is never cached', async () => {
+    const { res } = await post(BUFFERED, validAsk());
+    assert.equal(res.headers.get('cache-control'), 'no-store');
+  });
+});
+
+describe('NDJSON framing (§4.2)', () => {
+  test('CHAT-NDJSON-01: the response is application/x-ndjson and every line parses', async () => {
+    const { res, text, status } = await post(STREAM, validAsk());
+    assert.equal(status, 200, `stream endpoint returned ${status}: ${text.slice(0, 200)}`);
+    assert.match(
+      String(res.headers.get('content-type')),
+      /application\/x-ndjson/,
+      `got "${res.headers.get('content-type')}"`,
+    );
+    const { bad, parsed } = ndjson(text);
+    assert.deepEqual(bad, [], `unparsable NDJSON lines: ${bad.slice(0, 3).join(' | ')}`);
+    assert.ok(parsed.length >= 2, `expected at least meta + a terminal, got ${parsed.length}`);
+  });
+
+  test('CHAT-NDJSON-02: meta is first and exactly one terminal event is emitted', async () => {
+    const { text } = await post(STREAM, validAsk());
+    const { parsed } = ndjson(text);
+    assert.equal(parsed[0] && parsed[0].t, 'meta', `first event was ${JSON.stringify(parsed[0])}`);
+    const terminals = parsed.filter((e) => TERMINALS.has(e.t));
+    assert.equal(
+      terminals.length,
+      1,
+      `exactly one terminal event: got ${terminals.map((t) => t.t).join(', ') || 'none'}`,
+    );
+    assert.equal(parsed[parsed.length - 1].t, terminals[0].t, `the terminal must be last`);
+  });
+
+  test('CHAT-NDJSON-03: meta reports how many chunks were actually searched', async () => {
+    const { text } = await post(STREAM, validAsk());
+    const { parsed } = ndjson(text);
+    const meta = parsed.find((e) => e.t === 'meta');
+    assert.ok(meta, `no meta event: ${text.slice(0, 200)}`);
+    assert.ok(
+      Number.isInteger(meta.searched) && meta.searched > 0,
+      `searched must be the real candidate count, got ${JSON.stringify(meta.searched)}`,
+    );
+    assert.ok(
+      Number.isInteger(meta.serverMs) && meta.serverMs >= 0,
+      `serverMs must be measured, got ${JSON.stringify(meta.serverMs)}`,
+    );
+  });
+
+  test('CHAT-NDJSON-04: sources arrive before the first sentence, with resolvable provenance', async () => {
+    const { text } = await post(STREAM, validAsk());
+    const { parsed } = ndjson(text);
+    const srcIdx = parsed.findIndex((e) => e.t === 'sources');
+    const sentIdx = parsed.findIndex((e) => e.t === 'sentence');
+    assert.ok(srcIdx >= 0, `no sources event was emitted: ${text.slice(0, 300)}`);
+    assert.ok(
+      sentIdx === -1 || srcIdx < sentIdx,
+      `§4.3: the retrieved artefacts are the perceived first payload — they must precede prose`,
+    );
+    for (const s of parsed[srcIdx].sources) {
+      assert.equal(typeof s.id, 'string');
+      assert.ok(Number.isInteger(s.ordinal) && s.ordinal >= 1, `ordinal: ${JSON.stringify(s.ordinal)}`);
+      assert.ok(typeof s.title === 'string' && s.title.length > 0, `empty title on ${s.id}`);
+      assert.ok(
+        typeof s.provenanceLine === 'string' && /retrieved\s+\d{4}-\d{2}-\d{2}/.test(s.provenanceLine),
+        `R-69: every source carries a provenance line with a real retrieval date. ` +
+          `got ${JSON.stringify(s.provenanceLine)} on ${s.id}`,
+      );
+      assert.ok(
+        s.siteAnchor !== undefined && s.artefactUrl !== undefined,
+        `a citation must deep-link somewhere: ${JSON.stringify(s)}`,
+      );
+      assert.ok(
+        (typeof s.siteAnchor === 'string' && s.siteAnchor.startsWith('#')) ||
+          typeof s.artefactUrl === 'string',
+        `neither an in-page anchor nor an external artefact on ${s.id}`,
+      );
+    }
+  });
+});
+
+describe('Streaming, measured rather than assumed (§4.1, §4.3, R-71)', () => {
+  test('CHAT-STREAM-01: the response really is chunked — 3+ arrivals spread over 400 ms', async () => {
+    const r = await readTimed(STREAM, validAsk({ question: 'Describe his delivery work at the ATO in detail.' }));
+    assert.equal(r.status, 200, `stream endpoint returned ${r.status}: ${r.text.slice(0, 200)}`);
+    assert.ok(
+      r.arrivals.length >= 3,
+      `§4.1 step 3: fewer than 3 chunk arrivals is a buffered response wearing a stream's ` +
+        `clothes. arrivals=${JSON.stringify(r.arrivals)}`,
+    );
+    const spread = r.arrivals[r.arrivals.length - 1] - r.arrivals[0];
+    assert.ok(
+      spread >= 400,
+      `arrivals must be spread over at least 400 ms; got ${spread} ms across ` +
+        `${r.arrivals.length} chunks`,
+    );
+  });
+
+  test('CHAT-STREAM-02: no Content-Length — a length is the proof nothing streamed', async () => {
+    const { res } = await post(STREAM, validAsk());
+    assert.equal(
+      res.headers.get('content-length'),
+      null,
+      `the buffered baseline returns content-length: 629. A streamed NDJSON response has none.`,
+    );
+    assert.equal(res.headers.get('x-accel-buffering'), 'no');
+  });
+
+  test('CHAT-PERF-01 (R-71): perceived first payload under one second, p95 over 20 runs', async () => {
+    const RUNS = Number(process.env.CHAT_PERF_RUNS || 20);
+    const firstPayload = [];
+    const failures = [];
+    for (let i = 0; i < RUNS; i += 1) {
+      const r = await readTimed(STREAM, validAsk({ question: `What did he do at ANZ? (${i})` }));
+      if (r.status !== 200) {
+        failures.push(`run ${i}: HTTP ${r.status} ${r.text.slice(0, 120)}`);
+        continue;
+      }
+      firstPayload.push(r.arrivals[0]);
+    }
+    assert.deepEqual(failures, [], `runs that never answered:\n  ${failures.slice(0, 5).join('\n  ')}`);
+    firstPayload.sort((a, b) => a - b);
+    const p = (q) => firstPayload[Math.min(firstPayload.length - 1, Math.floor(q * firstPayload.length))];
+    const p50 = p(0.5);
+    const p95 = p(0.95);
+    assert.ok(
+      p50 < 400,
+      `firstPayloadMs p50 must be under 400 ms — got ${p50} ms over ${firstPayload.length} runs`,
+    );
+    assert.ok(
+      p95 < 1000,
+      `R-71's "perceived first token under one second" is satisfied by firstPayloadMs p95 < ` +
+        `1000 ms. got ${p95} ms. Samples: ${JSON.stringify(firstPayload)}`,
+    );
+  });
+
+  test('CHAT-DEGRADE-03: the buffered path still delivers sources in its first object', async () => {
+    const { text, status } = await post(BUFFERED, validAsk());
+    assert.equal(status, 200, `buffered endpoint returned ${status}: ${text.slice(0, 200)}`);
+    const { parsed, bad } = ndjson(text);
+    assert.deepEqual(bad, [], `buffered body is not NDJSON-framed: ${bad.slice(0, 2).join(' | ')}`);
+    assert.ok(
+      parsed.some((e) => e.t === 'sources'),
+      `§4.4: when streaming is unavailable the sources payload still arrives in the ` +
+        `response body's first flush, so the perceived-first-payload contract survives ` +
+        `degradation. body: ${text.slice(0, 300)}`,
+    );
+  });
+});
diff --git a/tests/grounding/calibration.json b/tests/grounding/calibration.json
new file mode 100644
index 0000000..8c55d72
--- /dev/null
+++ b/tests/grounding/calibration.json
@@ -0,0 +1,74 @@
+{
+  "$schema": "tests/grounding/calibration.schema — SPEC-chatbot-uplift.md §2.7",
+  "purpose": "IN_CORPUS_MIN_SCORE and IN_CORPUS_MIN_COVERAGE are the only two numbers that decide whether the bot speaks or declines. They are fixed by this fixture, not by taste. scripts/validate/chat_retrieval_calibration.mjs derives them and fails if functions/chat/config.js disagrees.",
+  "targets": {
+    "outOfCorpusPrecision": 1.0,
+    "inCorpusRecall": 0.9,
+    "topKForRecall": 3
+  },
+  "note": "expectChunkPrefix, not an exact chunk id. §2.3 fixes the id GRAMMAR ('cv.role.<roleKey>.bullet.NN') but the ordinal suffix is assigned by the builder from the canonical data. A prefix is the strongest assertion that can be made without inventing an id the builder has not yet allocated; it is still falsifiable — a retrieval that returns a repositories chunk for an ATO question fails it.",
+  "inCorpus": [
