+#!/usr/bin/env node
+/**
+ * Calibrate — and then police — the two numbers that decide whether the bot
+ * speaks or declines.
+ *
+ * Run:  node scripts/validate/chat_retrieval_calibration.mjs
+ *
+ * Contract: SPEC-chatbot-uplift.md §2.7 · R-66, R-67 · SC-43.1.
+ *
+ * IN_CORPUS_MIN_SCORE and IN_CORPUS_MIN_COVERAGE are the only constants in the
+ * whole chatbot that gate honesty. They are fixed by tests/grounding/calibration.json,
+ * not by taste. This script runs retrieval over that fixture with NO MODEL CALL AT
+ * ALL — so it is free, deterministic, and can run in CI on every commit — and then:
+ *
+ *   1. asserts out-of-corpus precision is 1.00: all 20 questions the corpus cannot
+ *      answer fall below the gate. One leak fails the run.
+ *   2. asserts in-corpus recall >= 0.90: at least 36 of 40 pass the gate AND carry a
+ *      chunk from the expected corpus region in the top 3.
+ *   3. derives the LOWEST IN_CORPUS_MIN_SCORE (to 0.1) and the HIGHEST
+ *      IN_CORPUS_MIN_COVERAGE (to 0.01) that satisfy both, and FAILS if
+ *      functions/chat/config.js disagrees — so the constants can never drift away
+ *      from the evidence that justified them.
+ *
+ * This is the mechanism that makes "zero fabrications" a measured property rather
+ * than a hope.
+ */
+import { readFileSync, existsSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { fileURLToPath } from 'node:url';
+import { dirname, resolve } from 'node:path';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(HERE, '../..');
+const require_ = createRequire(import.meta.url);
+
+function die(msg) {
+  console.error(`\nCALIBRATION FAILED\n\n${msg}\n`);
+  process.exit(1);
+}
+
+const FIXTURE_PATH = resolve(ROOT, 'tests/grounding/calibration.json');
+if (!existsSync(FIXTURE_PATH)) die(`tests/grounding/calibration.json does not exist.`);
+const FIXTURE = JSON.parse(readFileSync(FIXTURE_PATH, 'utf8'));
+
+const IN = FIXTURE.inCorpus;
+const OUT = FIXTURE.outOfCorpus;
+if (IN.length !== 40) die(`the fixture must carry exactly 40 in-corpus questions; it carries ${IN.length}.`);
+if (OUT.length !== 20) die(`the fixture must carry exactly 20 out-of-corpus questions; it carries ${OUT.length}.`);
+
+let config;
+let retrieveModule;
+try {
+  config = require_(resolve(ROOT, 'functions/chat/config.js'));
+} catch (err) {
+  die(
+    `functions/chat/config.js could not be loaded — the two thresholds have no home yet.\n` +
+      `  ${err.message}`,
+  );
+}
+try {
+  retrieveModule = require_(resolve(ROOT, 'functions/chat/retrieve.js'));
+} catch (err) {
+  die(
+    `functions/chat/retrieve.js could not be loaded — there is no retrieval layer to calibrate.\n` +
+      `  R-66 requires the bot answer only from the R-8 index; today lib/miniVicBrain.ts:70-72\n` +
+      `  concatenates the entire hand-written knowledge base into the prompt instead.\n` +
+      `  ${err.message}`,
+  );
+}
+
+const { scoreQuestion } = retrieveModule;
+if (typeof scoreQuestion !== 'function') {
+  die(
+    `functions/chat/retrieve.js exports no scoreQuestion({ question, scope }).\n` +
+      `  Calibration needs the RANKING before the gate is applied: { ranked: [{ id, corpus,\n` +
+      `  score, coverage }], searched }. Without it the thresholds cannot be derived from\n` +
+      `  evidence and would have to be chosen by taste, which §2.7 forbids.`,
+  );
+}
+
+/* ------------------------------------------------------------------ *
+ * Measure                                                             *
+ * ------------------------------------------------------------------ */
+
+function measure(question) {
+  const r = scoreQuestion({ question, scope: 'all' });
+  const ranked = (r && r.ranked) || [];
+  const top = ranked[0] || { score: 0, coverage: 0 };
+  return {
+    question,
+    searched: r ? r.searched : 0,
+    bestScore: Number(top.score) || 0,
+    bestCoverage: Number(top.coverage) || 0,
+    top3: ranked.slice(0, 3).map((x) => x.id),
+  };
+}
+
+const inMeasured = IN.map((row) => ({ ...measure(row.q), expectChunkPrefix: row.expectChunkPrefix }));
+const outMeasured = OUT.map((row) => ({ ...measure(row.q), why: row.why }));
+
+const noSearch = [...inMeasured, ...outMeasured].filter((m) => !(m.searched > 0));
+if (noSearch.length) {
+  die(
+    `${noSearch.length} of 60 questions scored zero chunks. Retrieval is not reading the index.\n` +
+      `  first: ${JSON.stringify(noSearch[0].question)}`,
+  );
+}
+
+/* ------------------------------------------------------------------ *
+ * Derive                                                              *
+ * ------------------------------------------------------------------ */
+
+const passesGate = (m, minScore, minCov) => m.bestScore >= minScore && m.bestCoverage >= minCov;
+const hitsExpected = (m) => m.top3.some((id) => String(id).startsWith(m.expectChunkPrefix));
+
+function evaluate(minScore, minCov) {
+  const leaks = outMeasured.filter((m) => passesGate(m, minScore, minCov));
+  const recalled = inMeasured.filter((m) => passesGate(m, minScore, minCov) && hitsExpected(m));
+  return {
+    precision: (OUT.length - leaks.length) / OUT.length,
+    recall: recalled.length / IN.length,
+    leaks,
+    recalled,
+  };
+}
+
+const SCORE_GRID = [];
+for (let s = 0; s <= 200; s += 1) SCORE_GRID.push(Number((s * 0.1).toFixed(1)));
+const COV_GRID = [];
+for (let c = 0; c <= 100; c += 1) COV_GRID.push(Number((c * 0.01).toFixed(2)));
+
+let derived = null;
+for (const s of SCORE_GRID) {
+  for (const c of [...COV_GRID].reverse()) {
+    const e = evaluate(s, c);
+    if (e.precision >= FIXTURE.targets.outOfCorpusPrecision && e.recall >= FIXTURE.targets.inCorpusRecall) {
+      derived = { minScore: s, minCoverage: c, ...e };
+      break;
+    }
+  }
+  if (derived) break;
+}
+
+if (!derived) {
+  const at = evaluate(config.IN_CORPUS_MIN_SCORE, config.IN_CORPUS_MIN_COVERAGE);
+  die(
+    `No (IN_CORPUS_MIN_SCORE, IN_CORPUS_MIN_COVERAGE) pair on the grid reaches\n` +
+      `  out-of-corpus precision ${FIXTURE.targets.outOfCorpusPrecision} AND in-corpus recall ` +
+      `${FIXTURE.targets.inCorpusRecall}.\n\n` +
+      `  At the configured pair (${config.IN_CORPUS_MIN_SCORE}, ${config.IN_CORPUS_MIN_COVERAGE}):\n` +
+      `    precision ${at.precision.toFixed(2)}, recall ${at.recall.toFixed(2)}\n` +
+      `    leaked   : ${at.leaks.map((m) => m.question).slice(0, 5).join(' | ') || 'none'}\n\n` +
+      `  §2.1's named mitigation applies: the fix is an entry in functions/data/chat-aliases.json,\n` +
+      `  read by a reviewer in the diff — never a hidden heuristic and never a lowered target.`,
+  );
+}
+
+/* ------------------------------------------------------------------ *
+ * Police                                                              *
+ * ------------------------------------------------------------------ */
+
+const drift = [];
+if (config.IN_CORPUS_MIN_SCORE !== derived.minScore) {
+  drift.push(
+    `IN_CORPUS_MIN_SCORE is ${config.IN_CORPUS_MIN_SCORE}; the lowest value the fixture ` +
+      `supports is ${derived.minScore}`,
+  );
+}
+if (config.IN_CORPUS_MIN_COVERAGE !== derived.minCoverage) {
+  drift.push(
+    `IN_CORPUS_MIN_COVERAGE is ${config.IN_CORPUS_MIN_COVERAGE}; the highest value the ` +
+      `fixture supports is ${derived.minCoverage}`,
+  );
+}
+
+const atConfigured = evaluate(config.IN_CORPUS_MIN_SCORE, config.IN_CORPUS_MIN_COVERAGE);
+
+console.log('\nCHAT RETRIEVAL CALIBRATION — SPEC-chatbot-uplift.md §2.7\n');
+console.log(`  fixture            : 40 in-corpus, 20 out-of-corpus`);
+console.log(`  derived thresholds : IN_CORPUS_MIN_SCORE ${derived.minScore}, IN_CORPUS_MIN_COVERAGE ${derived.minCoverage}`);
+console.log(`  config thresholds  : IN_CORPUS_MIN_SCORE ${config.IN_CORPUS_MIN_SCORE}, IN_CORPUS_MIN_COVERAGE ${config.IN_CORPUS_MIN_COVERAGE}`);
+console.log(`  at config          : out-of-corpus precision ${atConfigured.precision.toFixed(2)}, in-corpus recall ${atConfigured.recall.toFixed(2)}`);
+if (atConfigured.leaks.length) {
+  console.log(`  leaks at config    :`);
+  for (const m of atConfigured.leaks) {
+    console.log(`      ${m.question}  (score ${m.bestScore.toFixed(2)}, coverage ${m.bestCoverage.toFixed(2)}) — ${m.why}`);
+  }
+}
+const missed = inMeasured.filter((m) => !(passesGate(m, config.IN_CORPUS_MIN_SCORE, config.IN_CORPUS_MIN_COVERAGE) && hitsExpected(m)));
+if (missed.length) {
+  console.log(`  missed at config   :`);
+  for (const m of missed.slice(0, 10)) {
+    console.log(`      ${m.question}  (score ${m.bestScore.toFixed(2)}, coverage ${m.bestCoverage.toFixed(2)}, top3 ${m.top3.join(', ') || 'none'})`);
+  }
+}
+console.log('');
+
+const problems = [];
+if (atConfigured.precision < FIXTURE.targets.outOfCorpusPrecision) {
+  problems.push(
+    `out-of-corpus precision ${atConfigured.precision.toFixed(2)} < ` +
+      `${FIXTURE.targets.outOfCorpusPrecision}. One leak is a fabrication waiting to happen.`,
+  );
+}
+if (atConfigured.recall < FIXTURE.targets.inCorpusRecall) {
+  problems.push(
+    `in-corpus recall ${atConfigured.recall.toFixed(2)} < ${FIXTURE.targets.inCorpusRecall}. ` +
+      `A bot that refuses questions it can answer is a different failure, and just as real.`,
+  );
+}
+problems.push(...drift);
+
+if (problems.length) die(problems.join('\n\n'));
+
+console.log('Calibration green: the thresholds in config.js are the ones the fixture derives.\n');
