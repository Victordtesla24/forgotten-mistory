+#!/usr/bin/env node
+/**
+ * telemetry_contract_audit.mjs — executable acceptance checks for R-87 (first-party,
+ * privacy-respecting telemetry), R-88 (telemetry feeds the reopen loop) and R-183
+ * (the site's statement about its own analytics matches the implementation exactly,
+ * changed in the same commit).
+ *
+ * Runs with zero dependencies against the source tree. Build-time / source-level
+ * properties only; the browser-observable properties are in
+ * tests/overhaul/telemetry-first-party.spec.ts and the collector's behaviour is in
+ * tests/telemetry/collector.contract.mjs.
+ *
+ * The rule this file exists to enforce, above every other check in it:
+ *
+ *   The site currently says "no analytics, no trackers, no cookies" and that is
+ *   TRUE — 0 third-party hosts, 22/22 first-party requests, 0 cookies, 0 storage
+ *   keys (T40-self-claim-register.md, measured 2026-09-03). It is a
+ *   Preservation-Register-adjacent asset. The moment a collector exists, that
+ *   sentence becomes a lie, so TEL-183 below is BIDIRECTIONAL: the claim and the
+ *   implementation must move together or the gate fails either way round.
+ *
+ * Usage:  node scripts/validate/telemetry_contract_audit.mjs
+ * Exit:   0 if all checks PASS, 1 otherwise. Prints a per-check report.
+ */
+import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
+import { join } from 'node:path';
+
+const ROOT = process.cwd();
+const results = [];
+const record = (id, name, pass, detail) => results.push({ id, name, pass, detail });
+const read = (p) => {
+  try {
+    return readFileSync(join(ROOT, p), 'utf8');
+  } catch {
+    return null;
+  }
+};
+const has = (p) => existsSync(join(ROOT, p));
+
+// ───────────────────────────────────────────────────────────────────────────
+// The canonical strings. These are the contract. A test that asserted "the
+// colophon mentions telemetry" would pass on a sentence that lied about what is
+// collected, so every one of these is pinned verbatim.
+// ───────────────────────────────────────────────────────────────────────────
+
+/** The nine measured dimensions R-87 enumerates. These are also the ONLY event
+ *  names the collector may accept — the list is the contract, not a suggestion. */
+const MEASURED_EVENTS = [
+  'dwell',
+  'scroll-depth',
+  'drop-off',
+  'carousel-depth',
+  'chatbot-session',
+  'chatbot-topic',
+  'avatar-play',
+  'avatar-complete',
+  'conversion',
+];
+
+/** Never collected. Each is a field or capability the beacon and the collector
+ *  must both be incapable of carrying — not merely "not currently sending". */
+const NEVER_COLLECTED = [
+  'cookie',
+  'identifier',
+  'fingerprint',
+  'ip-address',
+  'free-text',
+  'third-party-request',
+  'cross-site',
+  'personal-data',
+];
+
+/** Honest about what this page does NOT author (SC-30, SC-23). */
+const NOT_AUTHORED_BY_THIS_PAGE = [
+  'firebase-hosting-request-log',
+  'firebase-functions-request-log',
+  'openrouter-chat-question',
+];
+
+/** Raw-event retention, in days. Pinned here AND asserted to equal the number the
+ *  collector enforces AND the number the published sentence prints. */
+const RETENTION_DAYS = 30;
+
+/** The clause that must appear inside listenContent.colophon, verbatim. The rest
+ *  of the colophon (the WebGL clause) belongs to another work item, so this is a
+ *  substring assertion rather than a whole-line one. */
+const CANONICAL_COLOPHON_CLAUSE =
+  'measured on this origin only: dwell, scroll depth, drop-off, carousel depth, ' +
+  'chatbot sessions and topics, avatar plays and completion, and which path reached ' +
+  'a conversation · never collected: cookies, identifiers, fingerprints, IP addresses, ' +
+  'or anything you type';
+
+/** Vitrine plate 06 ("This site") description, verbatim. */
+const CANONICAL_VITRINE_SELF_DESCRIPTION =
+  'The page you are reading: static export, one WebGL context per section, and ' +
+  'first-party cookieless measurement that counts what the sections do, never who you are.';
+
+/** The full disclosure sentence. Neither short line above can carry SC-30 and
+ *  SC-23, so the notice does, and the page renders it. */
+const CANONICAL_MEASUREMENT_NOTICE =
+  'This page measures itself, not you: how long each section holds attention, how far ' +
+  'the page is scrolled, where visitors leave, how deep the carousel is explored, how ' +
+  'many chatbot sessions start and which topics they cover, how often the avatar is ' +
+  'played and finished, and which route reached a conversation. Every event goes to ' +
+  'this origin and nowhere else, and carries no cookie, no identifier, no fingerprint, ' +
+  'no IP address and no text you typed — so no event can be traced back to a person, ' +
+  'and there is nothing here to consent to. Two things this page does not author: ' +
+  'Firebase Hosting and Cloud Functions keep their own request logs, and a question ' +
+  'put to MiniVic is answered by a model at OpenRouter, so that question leaves this ' +
+  'origin. Raw events are deleted after 30 days; only the counts survive.';
+
+/** The claim the site makes TODAY. Preserved here so the bidirectional lock can
+ *  recognise it and say precisely which half of R-183 was left behind. */
+const LEGACY_CLAIM_FRAGMENTS = ['no analytics, no trackers, no cookies', 'no analytics.'];
+
+/** Same-origin collector route. An absolute URL here would forfeit the site's
+ *  zero-third-party-request property, which is the whole point of the design. */
+const COLLECTOR_ROUTE = '/api/telemetry';
+
+const BEACON_SRC = 'lib/telemetry/beacon.ts';
+const SCHEMA_SRC = 'lib/telemetry/schema.ts';
+const STORE_SRC = 'lib/telemetry/store.ts';
+const COLLECTOR_LIB = 'functions/lib/telemetry.js';
+const FUNCTIONS_INDEX = 'functions/index.js';
+const AGGREGATE_JSON = 'app/data/generated/telemetry-aggregate.json';
+const AGGREGATE_SCRIPT = 'scripts/build/aggregate_telemetry.mjs';
+const LISTEN_DATA = 'app/data/portfolio/listen.ts';
+const VITRINE_DATA = 'app/data/portfolio/vitrine.ts';
+
+// ── TEL-SRC-01 — the beacon module exists ──────────────────────────────────
+function checkBeaconExists() {
+  const src = read(BEACON_SRC);
+  record(
+    'TEL-SRC-01',
+    'The first-party beacon module exists',
+    src !== null,
+    src === null ? `${BEACON_SRC} is absent — R-87 has no client instrumentation at all` : `${BEACON_SRC} present (${src.length} bytes)`,
+  );
+}
+
+// ── TEL-SRC-02 — the beacon uses sendBeacon to a SAME-ORIGIN relative path ──
+function checkBeaconTransport() {
+  const src = read(BEACON_SRC) ?? '';
+  const usesSendBeacon = /navigator\s*\.\s*sendBeacon\s*\(/.test(src);
+  const routeLiteral = new RegExp(`['"\`]${COLLECTOR_ROUTE}['"\`]`).test(src);
+  // Any absolute URL in the beacon would put a second origin on the page.
+  const absoluteUrls = src.match(/https?:\/\/[^\s'"`)]+/g) ?? [];
+  const offending = absoluteUrls.filter((u) => !u.startsWith('http://localhost') && !u.startsWith('http://127.0.0.1'));
+  const pass = usesSendBeacon && routeLiteral && offending.length === 0;
+  record(
+    'TEL-SRC-02',
+    `The beacon posts via navigator.sendBeacon to the same-origin path ${COLLECTOR_ROUTE}`,
+    pass,
+    [
+      `navigator.sendBeacon(: ${usesSendBeacon}`,
+      `'${COLLECTOR_ROUTE}' literal: ${routeLiteral}`,
+      `absolute URLs in beacon: ${offending.length ? offending.join(', ') : 'none'}`,
+    ].join(' · '),
+  );
+}
+
+// ── TEL-SRC-03 — the beacon cannot re-identify anyone ──────────────────────
+function checkBeaconCannotIdentify() {
+  const src = read(BEACON_SRC) ?? '';
+  const FORBIDDEN = [
+    'document.cookie',
+    'localStorage',
+    'sessionStorage',
+    'indexedDB',
+    'navigator.userAgent',
+    'navigator.language',
+    'navigator.hardwareConcurrency',
+    'navigator.deviceMemory',
+    'navigator.connection',
+    'screen.width',
+    'screen.height',
+    'getTimezoneOffset',
+    'toDataURL',
+    'document.referrer',
+  ];
+  const found = FORBIDDEN.filter((needle) => src.includes(needle));
+  record(
+    'TEL-SRC-03',
+    'The beacon reads no cookie, no storage and no device/browser attribute that could re-identify a visitor',
+    src !== '' && found.length === 0,
+    src === '' ? 'beacon module absent — nothing to inspect' : `forbidden reads found: ${found.length ? found.join(', ') : 'none'}`,
+  );
+}
+
+// ── TEL-SRC-04 — the collector and the pruner are deployed Cloud Functions ──
+function checkFunctionsExported() {
+  const src = read(FUNCTIONS_INDEX) ?? '';
+  const collect = /exports\.telemetryCollect\s*=/.test(src);
+  const prune = /exports\.telemetryPrune\s*=/.test(src);
+  record(
+    'TEL-SRC-04',
+    'functions/index.js exports telemetryCollect and telemetryPrune (D-04: the server side is the already-working Functions path)',
+    collect && prune,
+    `exports.telemetryCollect: ${collect} · exports.telemetryPrune: ${prune}`,
+  );
+}
+
+// ── TEL-SRC-05 — the collector is reachable same-origin via a Hosting rewrite ──
+function checkRewrite() {
+  let json = null;
+  try {
+    json = JSON.parse(read('firebase.json') ?? 'null');
+  } catch {
+    json = null;
+  }
+  const rewrites = json?.hosting?.rewrites ?? [];
+  const hit = rewrites.find((r) => r?.source === COLLECTOR_ROUTE);
+  const ok = !!hit && hit?.function?.functionId === 'telemetryCollect';
+  record(
+    'TEL-SRC-05',
+    `firebase.json rewrites ${COLLECTOR_ROUTE} to telemetryCollect, so the collector is first-party by construction`,
+    ok,
+    ok ? `${COLLECTOR_ROUTE} -> ${hit.function.functionId} (${hit.function.region ?? 'no region'})` : `no rewrite for ${COLLECTOR_ROUTE}; rewrites present: ${rewrites.map((r) => r?.source).join(', ') || 'none'}`,
+  );
+}
+
+// ── TEL-SRC-06 — no new origin entered the CSP ─────────────────────────────
+function checkCspUnchanged() {
+  let json = null;
+  try {
+    json = JSON.parse(read('firebase.json') ?? 'null');
+  } catch {
+    json = null;
+  }
+  const headerBlocks = json?.hosting?.headers ?? [];
+  const csp = headerBlocks
+    .flatMap((b) => b?.headers ?? [])
+    .find((h) => h?.key === 'Content-Security-Policy')?.value;
+  const connectSrc = csp ? (csp.split(';').find((d) => d.trim().startsWith('connect-src')) ?? '').trim() : '';
+  const EXPECTED =
+    "connect-src 'self' ws: wss: https://api.github.com https://generativelanguage.googleapis.com https://*.googleapis.com";
+  record(
+    'TEL-SRC-06',
+    'The telemetry collector adds NO host to connect-src — the zero-third-party-request property survives instrumentation',
+    connectSrc === EXPECTED,
+    connectSrc ? `observed: ${connectSrc}` : 'no connect-src directive found in the CSP header',
+  );
+}
+
+// ── TEL-SRC-07 — the pure collector logic is separable and present ─────────
+function checkCollectorLib() {
+  const src = read(COLLECTOR_LIB);
+  const REQUIRED_EXPORTS = [
+    'ACCEPTED_EVENTS',
+    'RETENTION_DAYS',
+    'validateEnvelope',
+    'sanitiseEvent',
+    'pruneExpired',
+    'aggregateSections',
+    'underperformingSections',
+  ];
+  const missing = src === null ? REQUIRED_EXPORTS : REQUIRED_EXPORTS.filter((n) => !new RegExp(`\\b${n}\\b`).test(src));
+  record(
+    'TEL-SRC-07',
+    `${COLLECTOR_LIB} exposes the collector's pure logic so it is unit-testable off Firebase`,
+    src !== null && missing.length === 0,
+    src === null ? `${COLLECTOR_LIB} is absent` : `missing exports: ${missing.length ? missing.join(', ') : 'none'}`,
+  );
+}
+
+// ── TEL-SRC-08 — accepted event names are exactly the R-87 dimensions ──────
+function checkAcceptedEvents() {
+  const src = read(COLLECTOR_LIB) ?? '';
+  const missing = MEASURED_EVENTS.filter((e) => !src.includes(`'${e}'`) && !src.includes(`"${e}"`));
+  record(
+    'TEL-SRC-08',
+    'The collector names all nine R-87 dimensions as accepted events (dwell, scroll depth, drop-off, carousel depth, chatbot session, chatbot topic, avatar play, avatar completion, conversion)',
+    src !== '' && missing.length === 0,
+    src === '' ? 'collector lib absent' : `event names not found in the collector: ${missing.length ? missing.join(', ') : 'none'}`,
+  );
+}
+
+// ── TEL-SRC-09 — retention is a real, enforced, published number ───────────
+function checkRetention() {
+  const src = read(COLLECTOR_LIB) ?? '';
+  const m = src.match(/RETENTION_DAYS\s*=\s*(\d+)/);
+  const value = m ? Number(m[1]) : null;
+  const enforced = /pruneExpired/.test(src) && /RETENTION_DAYS/.test(src);
+  const inSentence = CANONICAL_MEASUREMENT_NOTICE.includes(`deleted after ${RETENTION_DAYS} days`);
+  const pass = value === RETENTION_DAYS && enforced && inSentence;
+  record(
+    'TEL-SRC-09',
+    `Raw-event retention is exactly ${RETENTION_DAYS} days, is enforced by pruneExpired, and is the same number the published sentence prints`,
+    pass,
+    `RETENTION_DAYS in collector: ${value ?? 'not found'} · pruneExpired references it: ${enforced} · sentence prints ${RETENTION_DAYS}: ${inSentence}`,
+  );
+}
+
+// ── TEL-183 — the bidirectional self-claim lock ────────────────────────────
+/**
+ * The one check that cannot be satisfied by doing half the work. Either:
+ *   (a) no collector exists AND the legacy "no analytics" claim stands — the
+ *       state the repository was in on 2026-09-03, which was honest; or
+ *   (b) the collector exists AND both published lines have been rewritten to the
+ *       canonical strings above.
+ * Anything in between is R-183's exact prohibition: a site stating something
+ * about itself that its own code contradicts.
+ */
+function checkSelfClaimLock() {
+  const listen = read(LISTEN_DATA) ?? '';
+  const vitrine = read(VITRINE_DATA) ?? '';
+  const collectorExists = has(COLLECTOR_LIB) || /exports\.telemetryCollect/.test(read(FUNCTIONS_INDEX) ?? '');
+  const beaconExists = has(BEACON_SRC);
+  const instrumented = collectorExists || beaconExists;
+
+  const legacyPresent = LEGACY_CLAIM_FRAGMENTS.some((f) => listen.includes(f) || vitrine.includes(f));
+  const colophonReconciled = listen.includes(CANONICAL_COLOPHON_CLAUSE);
+  const vitrineReconciled = vitrine.includes(CANONICAL_VITRINE_SELF_DESCRIPTION);
+
+  let pass;
+  let detail;
+  if (!instrumented) {
+    pass = legacyPresent && !colophonReconciled && !vitrineReconciled;
+    detail = `no instrumentation present; legacy claim standing: ${legacyPresent}`;
+  } else {
+    pass = colophonReconciled && vitrineReconciled && !legacyPresent;
+    detail = [
+      `instrumentation present (beacon: ${beaconExists}, collector: ${collectorExists})`,
+      `colophon carries the reconciled clause: ${colophonReconciled}`,
+      `vitrine plate 06 carries the reconciled description: ${vitrineReconciled}`,
+      `legacy "no analytics" claim still on the page: ${legacyPresent}`,
+    ].join(' · ');
+  }
+  record(
+    'TEL-183',
+    'R-183 lock: the analytics self-claim and the instrumentation are in the same state — both old, or both new, never one of each',
+    pass,
+    detail,
+  );
+}
+
+// ── TEL-SRC-10 — the colophon says exactly what is measured ───────────────
+function checkColophon() {
+  const listen = read(LISTEN_DATA) ?? '';
+  record(
+    'TEL-SRC-10',
+    'listenContent.colophon carries the reconciled measurement clause verbatim',
+    listen.includes(CANONICAL_COLOPHON_CLAUSE),
+    listen.includes(CANONICAL_COLOPHON_CLAUSE)
+      ? 'present'
+      : `absent. Required substring:\n      ${CANONICAL_COLOPHON_CLAUSE}`,
+  );
+}
+
+// ── TEL-SRC-11 — the vitrine's self-plate stops claiming "no analytics" ───
+function checkVitrinePlate() {
+  const vitrine = read(VITRINE_DATA) ?? '';
+  record(
+    'TEL-SRC-11',
+    'The vitrine plate for this site describes the measurement instead of denying it',
+    vitrine.includes(CANONICAL_VITRINE_SELF_DESCRIPTION),
+    vitrine.includes(CANONICAL_VITRINE_SELF_DESCRIPTION)
+      ? 'present'
+      : `absent. Required description:\n      ${CANONICAL_VITRINE_SELF_DESCRIPTION}`,
+  );
+}
+
+// ── TEL-SRC-12 — the full notice exists in content data, with its lists ───
+function checkMeasurementNotice() {
+  const listen = read(LISTEN_DATA) ?? '';
+  const hasSentence = listen.includes(CANONICAL_MEASUREMENT_NOTICE);
+  const hasKey = /measurementNotice\s*:/.test(listen);
+  const missingMeasured = MEASURED_EVENTS.filter((e) => !listen.includes(`'${e}'`));
+  const missingNever = NEVER_COLLECTED.filter((e) => !listen.includes(`'${e}'`));
+  const missingNotAuthored = NOT_AUTHORED_BY_THIS_PAGE.filter((e) => !listen.includes(`'${e}'`));
+  const pass =
+    hasKey && hasSentence && missingMeasured.length === 0 && missingNever.length === 0 && missingNotAuthored.length === 0;
+  record(
+    'TEL-SRC-12',
+    'listenContent.measurementNotice publishes the full sentence plus the machine-readable measured / neverCollected / notAuthoredByThisPage lists (SC-30 platform logs, SC-23 the question reaching OpenRouter)',
+    pass,
+    [
+      `measurementNotice key: ${hasKey}`,
+      `sentence verbatim: ${hasSentence}`,
+      `measured ids missing: ${missingMeasured.join(', ') || 'none'}`,
+      `neverCollected ids missing: ${missingNever.join(', ') || 'none'}`,
+      `notAuthoredByThisPage ids missing: ${missingNotAuthored.join(', ') || 'none'}`,
+    ].join(' · '),
+  );
+}
+
+// ── TEL-SRC-13 — the 2026-07-09 outage cannot recur ───────────────────────
+/**
+ * lib/githubTelemetry.ts returned a fresh object from getSnapshot() on every
+ * call; React compares with Object.is, so "changed" was true forever → React
+ * #185 → the root error boundary replaced the entire page. The replacement
+ * telemetry store must therefore return a CACHED reference, and must never read
+ * a device API inside a useState initializer (the second half of the same
+ * outage, which produced React #425).
+ */
+function checkNoSnapshotIdentityBreak() {
+  const dir = join(ROOT, 'lib/telemetry');
+  let files = [];
+  try {
+    files = readdirSync(dir).filter((f) => statSync(join(dir, f)).isFile() && /\.tsx?$/.test(f));
+  } catch {
+    files = [];
+  }
+  const offences = [];
+  for (const f of files) {
+    const src = readFileSync(join(dir, f), 'utf8');
+    // Any return inside a getSnapshot / getServerSnapshot that constructs a value.
+    const re = /(getServerSnapshot|getSnapshot)\s*[=:(][^\n]*\n?([\s\S]{0,400}?)(?:\n\s*\}|;)/g;
+    let m;
+    while ((m = re.exec(src)) !== null) {
+      const body = m[2];
+      const constructs = /return\s*(\{|\[|Object\.|JSON\.parse|new\s|[A-Za-z_$][\w$]*\s*\.\s*(map|filter|slice|concat)\s*\()/.test(
+        body,
+      );
+      if (constructs) offences.push(`${f}: ${m[1]} returns a freshly-constructed value`);
+    }
+    if (/useState\([^)]*navigator\./.test(src) || /useState\([^)]*window\./.test(src)) {
+      offences.push(`${f}: a device/browser API is read inside a useState initializer (React #425 hydration mismatch)`);
+    }
+  }
+  record(
+    'TEL-SRC-13',
+    'The telemetry store returns a cached snapshot reference and reads no device API in a useState initializer — the 2026-07-09 outage mode (React #185 / #425) is structurally excluded',
+    files.length > 0 && offences.length === 0,
+    files.length === 0
+      ? 'lib/telemetry/ contains no module to inspect'
+      : `files scanned: ${files.join(', ')} · offences: ${offences.length ? offences.join(' | ') : 'none'}`,
+  );
+}
+
+// ── TEL-SRC-14 — no consent wall anywhere (R-87, §9) ─────────────────────
+function checkNoConsentWall() {
+  const CONSENT_PHRASES = [
+    'we use cookies',
+    'accept cookies',
+    'cookie policy',
+    'manage preferences',
+    'accept all',
+    'reject all',
+    'consent to cookies',
+    'gdpr consent',
+  ];
+  const roots = ['app', 'components', 'lib'];
+  const hits = [];
+  const walk = (dir) => {
+    let entries;
+    try {
+      entries = readdirSync(join(ROOT, dir), { withFileTypes: true });
+    } catch {
+      return;
+    }
+    for (const e of entries) {
+      const rel = `${dir}/${e.name}`;
+      if (e.isDirectory()) {
+        walk(rel);
+        continue;
+      }
+      if (!/\.(ts|tsx|js|jsx)$/.test(e.name)) continue;
+      const text = (read(rel) ?? '').toLowerCase();
+      for (const p of CONSENT_PHRASES) if (text.includes(p)) hits.push(`${rel}: "${p}"`);
+    }
+  };
+  roots.forEach(walk);
+  record(
+    'TEL-SRC-14',
+    'No consent wall, cookie banner or preference dialog exists — nothing is collected that could require one',
+    hits.length === 0,
+    hits.length ? hits.join(' | ') : 'no consent vocabulary in app/, components/ or lib/',
+  );
+}
+
+// ── TEL-SRC-15 — the aggregate that feeds R-88 carries provenance ────────
+function checkAggregateProvenance() {
+  const raw = read(AGGREGATE_JSON);
+  if (raw === null) {
+    record('TEL-SRC-15', 'The R-88 aggregate exists and every metric carries provenance with a real retrievedAt', false, `${AGGREGATE_JSON} is absent — nothing feeds the reopen loop`);
+    return;
+  }
+  let data = null;
+  try {
+    data = JSON.parse(raw);
+  } catch (err) {
+    record('TEL-SRC-15', 'The R-88 aggregate exists and every metric carries provenance with a real retrievedAt', false, `${AGGREGATE_JSON} is not valid JSON: ${err.message}`);
+    return;
+  }
+  const problems = [];
+  const sections = data?.sections ?? {};
+  const ids = Object.keys(sections);
+  if (ids.length === 0) problems.push('no sections in the aggregate');
+  for (const id of ids) {
+    const sec = sections[id];
+    for (const [metric, field] of Object.entries(sec ?? {})) {
+      if (field === null || typeof field !== 'object') {
+        problems.push(`${id}.${metric} is a bare value, not a provenance-carrying field`);
+        continue;
+      }
+      if (field.kind !== 'sourced' && field.kind !== 'not-observable') {
+        problems.push(`${id}.${metric} has kind "${field.kind}" — must be 'sourced' or 'not-observable'`);
+        continue;
+      }
+      const at = field?.provenance?.retrievedAt;
+      const t = at ? Date.parse(at) : NaN;
+      if (!Number.isFinite(t)) problems.push(`${id}.${metric} has no parseable provenance.retrievedAt (got ${JSON.stringify(at)})`);
+      else if (t <= 0) problems.push(`${id}.${metric} retrievedAt is the epoch — a placeholder, not an observation`);
+      if (field.kind === 'sourced' && !field?.provenance?.method) problems.push(`${id}.${metric} has no provenance.method a reader could run`);
+      // R-175: an unobserved window is a positive not-observable record, never a zero.
+      if (field.kind === 'sourced' && field.value === 0 && field?.provenance?.sampleSize === 0) {
+        problems.push(`${id}.${metric} reports 0 from a zero-sample window — R-175 requires 'not-observable' with a reason`);
+      }
+    }
+  }
+  record(
+    'TEL-SRC-15',
+    'The R-88 aggregate exists and every metric carries provenance with a real retrievedAt, and never a zero standing in for an unobserved window',
+    problems.length === 0,
+    problems.length ? problems.slice(0, 10).join(' | ') : `${ids.length} sections, all fields provenance-carrying`,
+  );
+}
+
+// ── TEL-SRC-16 — the aggregate is refreshed by the build, not by hand ────
+function checkAggregateWiredIntoBuild() {
+  const pkgRaw = read('package.json') ?? '{}';
+  let pkg = {};
+  try {
+    pkg = JSON.parse(pkgRaw);
+  } catch {
+    pkg = {};
+  }
+  const buildStatic = pkg?.scripts?.['build:static'] ?? '';
+  const scriptExists = has(AGGREGATE_SCRIPT);
+  const wired = buildStatic.includes('aggregate_telemetry.mjs');
+  record(
+    'TEL-SRC-16',
+    'scripts/build/aggregate_telemetry.mjs exists and runs inside build:static — the aggregate is deploy-time, not a file someone remembers to update (the exact defect B-3 records for harvest_repos.mjs)',
+    scriptExists && wired,
+    `script present: ${scriptExists} · referenced by build:static: ${wired}`,
+  );
+}
+
+// ── TEL-SRC-17 — no third-party analytics dependency, ever ───────────────
+function checkNoThirdPartyAnalytics() {
+  const pkgRaw = read('package.json') ?? '{}';
+  let pkg = {};
+  try {
+    pkg = JSON.parse(pkgRaw);
+  } catch {
+    pkg = {};
+  }
+  const deps = Object.keys({ ...(pkg.dependencies ?? {}), ...(pkg.devDependencies ?? {}) });
+  const BANNED = ['@vercel/analytics', 'posthog-js', 'mixpanel-browser', 'analytics', 'plausible-tracker', 'react-ga', 'react-ga4', '@segment/analytics-next', 'amplitude-js', 'heap-api'];
+  const found = deps.filter((d) => BANNED.includes(d));
+  record(
+    'TEL-SRC-17',
+    'No third-party analytics package is a dependency',
+    found.length === 0,
+    found.length ? `banned dependencies: ${found.join(', ')}` : `${deps.length} dependencies, none of them a third-party analytics SDK`,
+  );
+}
+
+// ── TEL-SRC-18 — the schema module is shared, so client and server agree ──
+function checkSharedSchema() {
+  const schema = read(SCHEMA_SRC);
+  const store = read(STORE_SRC);
+  record(
+    'TEL-SRC-18',
+    'lib/telemetry/schema.ts and lib/telemetry/store.ts exist — one event vocabulary, one referentially-stable store',
+    schema !== null && store !== null,
+    `${SCHEMA_SRC}: ${schema !== null ? 'present' : 'ABSENT'} · ${STORE_SRC}: ${store !== null ? 'present' : 'ABSENT'}`,
+  );
+}
+
+// ── Run ────────────────────────────────────────────────────────────────────
+checkBeaconExists();
+checkBeaconTransport();
+checkBeaconCannotIdentify();
+checkFunctionsExported();
+checkRewrite();
+checkCspUnchanged();
+checkCollectorLib();
+checkAcceptedEvents();
+checkRetention();
+checkSelfClaimLock();
+checkColophon();
+checkVitrinePlate();
+checkMeasurementNotice();
+checkNoSnapshotIdentityBreak();
+checkNoConsentWall();
+checkAggregateProvenance();
+checkAggregateWiredIntoBuild();
+checkNoThirdPartyAnalytics();
+checkSharedSchema();
+
+const passed = results.filter((r) => r.pass).length;
+console.log('\nTelemetry contract audit — R-87 / R-88 / R-183\n');
+for (const r of results) {
+  console.log(`  ${r.pass ? 'PASS' : 'FAIL'}  ${r.id}  ${r.name}`);
+  console.log(`        ${r.detail}`);
+}
+console.log(`\n  ${passed}/${results.length} checks passed\n`);
+process.exit(passed === results.length ? 0 : 1);
