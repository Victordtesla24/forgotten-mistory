+describe('T-12 batteries — the whole calibration fixture, over the wire', () => {
+  /** Run the fixture once and share it across P-09, P-10 and P-11. */
+  const state = { inCorpus: [], outOfCorpus: [], ran: false };
+
+  before(async () => {
+    const run = async (q) => {
+      try {
+        return { q, r: await ask({ question: q, register: 'hiring', scope: 'all', turns: [] }) };
+      } catch (err) {
+        return { q, r: null, err };
+      }
+    };
+    const pool = async (items, worker, width = 4) => {
+      const out = [];
+      let i = 0;
+      await Promise.all(
+        Array.from({ length: width }, async () => {
+          while (i < items.length) {
+            const idx = i;
+            i += 1;
+            out[idx] = await worker(items[idx]);
+          }
+        }),
+      );
+      return out;
+    };
+    state.inCorpus = await pool(CALIBRATION.inCorpus.map((x) => x.q), run);
+    state.outOfCorpus = await pool(CALIBRATION.outOfCorpus.map((x) => x.q), run);
+    state.ran = true;
+  });
+
+  test('P-09: every citation resolves to a chunk that request actually retrieved — 0 orphans over 40', () => {
+    const orphans = [];
+    for (const { q, r, err } of state.inCorpus) {
+      if (!r) {
+        orphans.push(`${q} -> request failed: ${err && err.message}`);
+        continue;
+      }
+      if (!r.terminal) {
+        orphans.push(`${q} -> no terminal event at all (HTTP ${r.status}): ${r.raw.slice(0, 120)}`);
+        continue;
+      }
+      if (r.terminal.t !== 'done') {
+        orphans.push(`${q} -> an in-corpus question terminated "${r.terminal.t}", not "done"`);
+        continue;
+      }
+      const known = new Set(r.sources.map((s) => s.id));
+      for (const s of r.sentences) {
+        for (const c of s.cites || []) {
+          if (!known.has(c)) orphans.push(`${q} -> [c:${c}] not in that response's sources`);
+        }
+      }
+      if (r.sentences.flatMap((s) => s.cites || []).length === 0) {
+        orphans.push(`${q} -> answered with zero citations`);
+      }
+    }
+    assert.deepEqual(
+      orphans,
+      [],
+      `R-69: a citation naming a chunk that was not retrieved is a fabricated provenance ` +
+        `record. Budget is 0.\n  ${orphans.slice(0, 12).join('\n  ')}`,
+    );
+  });
+
+  test('P-10: every numeral appears in a retrieved chunk or in the question — 0 violations over 40', () => {
+    const violations = [];
+    for (const { q, r, err } of state.inCorpus) {
+      if (!r) {
+        violations.push(`${q} -> request failed: ${err && err.message}`);
+        continue;
+      }
+      if (!r.terminal) {
+        violations.push(`${q} -> no terminal event at all (HTTP ${r.status}): ${r.raw.slice(0, 120)}`);
+        continue;
+      }
+      if (r.sentences.length === 0) {
+        violations.push(
+          `${q} -> an in-corpus question produced no sentence to check. A numeral gate with ` +
+            `nothing to gate passes vacuously, and a gate that cannot fail is not a gate.`,
+        );
+        continue;
+      }
+      const allowed = permittedNumerals(r, q);
+      for (const s of r.sentences) {
+        for (const n of numerals(s.text || '')) {
+          if (!allowed.has(n)) violations.push(`${q} -> "${n}" in: ${String(s.text).slice(0, 120)}`);
+        }
+      }
+    }
+    assert.deepEqual(
+      violations,
+      [],
+      `V-2's allowlist is the empty set — there is no exemption for an obviously-fine ` +
+        `number.\n  ${violations.slice(0, 12).join('\n  ')}`,
+    );
+  });
+
+  test('P-11: all 20 out-of-corpus questions are refused — 0 fabrications', () => {
