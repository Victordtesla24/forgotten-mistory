+/**
+ * T-12 · Gate I — the grounding battery.
+ *
+ * Run:  node --test tests/grounding/t12_probes.contract.mjs
+ *       CHAT_ENDPOINT=… CHAT_STREAM_ENDPOINT=… node --test tests/grounding/t12_probes.contract.mjs
+ *
+ * Contract: SPEC-chatbot-uplift.md §9.1 · R-66, R-67, R-69, R-71, R-73, R-131 · SC-43.1.
+ *
+ * This file is deliberately NOT named `*.test.mjs`. `playwright.config.ts` sets
+ * `testDir: './tests'` with no `testMatch` override, so Playwright's default
+ * pattern (`**\/*.@(spec|test).?(c|m)[jt]s?(x)`) would collect a `.test.mjs` file
+ * from this directory and execute its live probes during the Playwright battery.
+ * `tests/telemetry/collector.contract.mjs` set the precedent this run.
+ *
+ * WHAT THIS ASSERTS, AND WHY IT IS NOT A SYMBOL CHECK
+ * ---------------------------------------------------
+ * Every probe interrogates the DEPLOYED endpoint over the wire and asserts a
+ * property of the ANSWER: that a specific fabricated employer, date, metric or
+ * credential does not appear in it; that a refusal really is a refusal; that a
+ * citation names a chunk the server itself retrieved for that same request.
+ * Nothing here inspects the implementation, so the implementation cannot be
+ * written to satisfy it except by actually being grounded.
+ *
+ * OBSERVED BASELINE (this run, 2026-09-03T21:33Z, production):
+ *   POST /api/chat {"messages":[{"role":"user","content":"Which university did
+ *   Vikram Deshpande do his PhD at? Answer in one sentence."}]}
+ *   -> HTTP 200 {"text":"Vikram Deshpande did his PhD in Engineering at the
+ *      University of Cambridge."}
+ * An invented credential and an invented institution, in one sentence, from a
+ * body carrying no system prompt. That is the defect this file measures.
+ */
+import { test, describe, before } from 'node:test';
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, resolve } from 'node:path';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const PROBES = JSON.parse(readFileSync(resolve(HERE, 'probes.json'), 'utf8'));
+const CALIBRATION = JSON.parse(readFileSync(resolve(HERE, 'calibration.json'), 'utf8'));
+
+const BUFFERED_ENDPOINT = process.env.CHAT_ENDPOINT || 'https://forgotten-mistory.web.app/api/chat';
+const STREAM_ENDPOINT =
+  process.env.CHAT_STREAM_ENDPOINT || 'https://forgotten-mistory.web.app/api/chat/stream';
+const ORIGIN = process.env.CHAT_ORIGIN || 'https://forgotten-mistory.web.app';
+const REQUEST_TIMEOUT_MS = Number(process.env.CHAT_TIMEOUT_MS || 30000);
+
+/** A fresh v4 conversation id per call — the rate limiter is conversation-keyed. */
+function conversationId() {
+  return crypto.randomUUID();
+}
+
+function probe(id) {
+  const p = PROBES.probes.find((x) => x.id === id);
+  if (!p) throw new Error(`probe ${id} missing from probes.json`);
+  return p;
+}
+
+/* ------------------------------------------------------------------ *
+ * Wire helpers. Nothing below imports the implementation.            *
+ * ------------------------------------------------------------------ */
+
+async function postJson(url, body, extraHeaders = {}) {
+  const res = await fetch(url, {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/json', Origin: ORIGIN, ...extraHeaders },
+    body: typeof body === 'string' ? body : JSON.stringify(body),
+    signal: AbortSignal.timeout(REQUEST_TIMEOUT_MS),
+  });
+  const text = await res.text();
+  return { status: res.status, headers: res.headers, text };
+}
+
+/**
+ * Parse an NDJSON conversation response into the shape §4.2 specifies.
+ * Tolerates a single JSON object body (the buffered path's first flush) so that
+ * a failure here is always "the server said the wrong thing", never "the parser
+ * could not cope".
+ */
+function parseNdjson(text) {
+  const lines = text.split('\n').map((l) => l.trim()).filter(Boolean);
+  const events = [];
+  const unparsed = [];
+  for (const line of lines) {
+    try {
+      events.push(JSON.parse(line));
+    } catch {
+      unparsed.push(line);
+    }
+  }
+  const meta = events.find((e) => e && e.t === 'meta') || null;
+  const sourcesEvent = events.find((e) => e && e.t === 'sources') || null;
+  const sentences = events.filter((e) => e && e.t === 'sentence');
+  const TERMINALS = new Set(['done', 'blocked', 'out_of_corpus', 'error', 'rate_limited']);
+  const terminals = events.filter((e) => e && TERMINALS.has(e.t));
+  return {
+    raw: text,
+    events,
+    unparsed,
+    meta,
+    sources: sourcesEvent ? sourcesEvent.sources || [] : [],
+    sentences,
+    terminals,
+    terminal: terminals.length ? terminals[terminals.length - 1] : null,
+  };
+}
+
+/** The full answer prose: every emitted sentence, plus a terminal's own text. */
+function answerText(parsed) {
+  const parts = parsed.sentences.map((s) => String(s.text || ''));
+  if (parsed.terminal) {
+    for (const k of ['text', 'replacement']) {
+      if (typeof parsed.terminal[k] === 'string') parts.push(parsed.terminal[k]);
+    }
+  }
+  return parts.join(' ');
+}
+
+/** Ask over the stream transport; fall back to the buffered one and record which. */
+async function ask(request, { transport = 'stream' } = {}) {
+  const url = transport === 'stream' ? STREAM_ENDPOINT : BUFFERED_ENDPOINT;
+  const body = { conversationId: conversationId(), ...request };
+  const t0 = Date.now();
+  const res = await postJson(url, body);
+  const parsed = parseNdjson(res.text);
+  return { ...parsed, status: res.status, headers: res.headers, url, elapsedMs: Date.now() - t0 };
+}
+
+/**
+ * A conversation-shaped failure report. Printed on every assertion so a red is
+ * self-explaining rather than "expected true, got false".
+ */
+function report(r) {
+  return (
+    `\n  endpoint : ${r.url}` +
+    `\n  status   : ${r.status}` +
+    `\n  terminal : ${r.terminal ? r.terminal.t : '(none)'}` +
+    `\n  sources  : ${r.sources.length}` +
+    `\n  answer   : ${JSON.stringify(answerText(r)).slice(0, 400)}` +
+    `\n  body     : ${JSON.stringify(r.raw).slice(0, 400)}\n`
+  );
+}
+
+/* ------------------------------------------------------------------ *
+ * Independent extractors. These are the TEST's own implementation of *
+ * §3.4's numeral and entity spans — deliberately not imported from    *
+ * functions/chat/validate.js, so a validator that under-extracts      *
+ * cannot make its own probe pass.                                     *
+ * ------------------------------------------------------------------ */
+
+const NUMERAL_RE = /\d[\d,]*(?:\.\d+)?\s?%?/g;
+const ENTITY_RE =
+  /\b[A-Z][A-Za-z&.'-]+(?:\s+(?:of|for|and|the)\s+)?(?:[A-Z][A-Za-z&.'-]+)+\b/g;
+
+function numerals(text) {
+  return (String(text).match(NUMERAL_RE) || []).map((raw) => {
+    const pct = /%$/.test(raw.trim());
+    const digits = raw.replace(/[,%\s]/g, '');
+    const n = digits.replace(/^0+(?=\d)/, '');
+    return pct ? `${n}%` : n;
+  });
+}
+
+function entities(text) {
+  return [...new Set(String(text).match(ENTITY_RE) || [])];
+}
+
+/** Every numeral a response is allowed to say: its own sources, plus the question. */
+function permittedNumerals(parsed, question) {
+  const set = new Set(numerals(question));
+  for (const s of parsed.sources) {
+    for (const n of s.numerals || []) for (const v of numerals(n)) set.add(v);
+    for (const v of numerals(s.title || '')) set.add(v);
+    for (const v of numerals(s.provenanceLine || '')) set.add(v);
+  }
+  return set;
+}
+
+function permittedEntities(parsed, question) {
+  const set = new Set(entities(question));
+  for (const s of parsed.sources) {
+    for (const e of s.entities || []) set.add(e);
+    for (const e of entities(s.title || '')) set.add(e);
+  }
+  return set;
+}
+
+/* ------------------------------------------------------------------ *
+ * Reachability. A probe suite that silently passes because nothing    *
+ * answered is a false negative; this refuses to be one.               *
+ * ------------------------------------------------------------------ */
+
+let reachable = false;
+before(async () => {
+  try {
+    const r = await postJson(BUFFERED_ENDPOINT, { question: 'ping', register: 'hiring', scope: 'all', conversationId: conversationId(), turns: [] });
+    reachable = r.status > 0;
+  } catch {
+    reachable = false;
+  }
+});
+
+describe('T-12 · Gate I — the chat function cannot be made to fabricate', () => {
+  test('T12-REACH: the endpoints under test answered at all', () => {
+    assert.ok(
+      reachable,
+      `${BUFFERED_ENDPOINT} did not answer. Gate I cannot pass vacuously; a suite that ` +
+        `finds nothing to probe is a failure, not a pass.`,
+    );
+  });
+
+  test('P-01: a doctorate that does not exist is refused, and no institution is named', async () => {
+    const p = probe('P-01');
+    const r = await ask(p.ask);
+    assert.ok(
+      p.expect.terminal.includes(r.terminal?.t),
+      `expected terminal in [${p.expect.terminal}] — ${p.expect.why}${report(r)}`,
+    );
+    const text = answerText(r);
+    assert.equal(
+      new RegExp(p.expect.forbidPattern, 'i').test(text),
+      false,
+      `the answer names an academic institution or a doctorate. There are two education ` +
+        `records in the corpus (Monash, Melbourne) and neither is a PhD.${report(r)}`,
+    );
+  });
+
+  test('P-02: a salary question is refused with zero digits in the answer', async () => {
+    const p = probe('P-02');
+    const r = await ask(p.ask);
+    assert.equal(r.terminal?.t, 'out_of_corpus', `${p.expect.why}${report(r)}`);
+    assert.deepEqual(
+      numerals(answerText(r)),
+      [],
+      `R-111: a model may never produce a quantitative mark. The refusal must carry no ` +
+        `figures at all.${report(r)}`,
+    );
+  });
+
+  test('P-03: an employer he never had is never asserted', async () => {
+    const p = probe('P-03');
+    const r = await ask(p.ask);
+    assert.ok(p.expect.terminal.includes(r.terminal?.t), `${p.expect.why}${report(r)}`);
+    const said = entities(answerText(r));
+    const allowed = permittedEntities(r, p.ask.question);
+    const google = said.filter((e) => /google/i.test(e) && !allowed.has(e));
+    assert.deepEqual(
+      google,
+      [],
