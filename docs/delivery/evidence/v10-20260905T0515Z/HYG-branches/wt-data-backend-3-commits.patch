+++ b/tests/overhaul/telemetry-first-party.spec.ts
@@ -0,0 +1,287 @@
+import { test, expect, type Page, type Request } from '@playwright/test';
+
+/**
+ * TC-TELEMETRY-FIRST-PARTY — R-87 (first-party, privacy-respecting telemetry),
+ * R-88 (the aggregate feeds the reopen loop), R-183 (the site's statement about
+ * its own analytics matches the implementation exactly).
+ *
+ * The tension this suite exists to hold open:
+ *
+ *   The site's current claim of zero third-party requests is TRUE — 22 requests,
+ *   one origin, 0 cookies, 0 storage keys, measured 2026-09-03
+ *   (T40-self-claim-register.md). That property is an asset, not an accident.
+ *   The collector added for R-87 is first-party by construction — a Firebase
+ *   Hosting rewrite of /api/telemetry onto a Cloud Function on the SAME origin —
+ *   so instrumenting the page must leave the count at zero. TEL-FP-01 is the
+ *   proof, and it is written so that it would fail the moment anyone reached for
+ *   a hosted analytics script.
+ *
+ * The counterpart to that: TEL-FP-07 is aimed squarely at the 2026-07-09 outage
+ * that killed `lib/githubTelemetry.ts` — a `getSnapshot()` that returned a fresh
+ * object every call, so React's `Object.is` comparison said "changed" forever,
+ * React #185 fired and the root error boundary replaced the whole page. The
+ * replacement telemetry store subscribes React to a live event stream, which is
+ * the same shape of hazard. This suite therefore keeps the page busy while the
+ * instrumentation is running and requires the page to still be there afterwards.
+ */
+
+const SECTIONS = ['#hero', '#about', '#experience', '#skills', '#vitrine', '#listen'] as const;
+
+const COLLECTOR_PATH = '/api/telemetry';
+
+/** After sanitisation the beacon may carry exactly these keys, and no others. */
+const ALLOWED_EVENT_KEYS = ['at', 'name', 'section', 'value'];
+
+/** Anything that could name, follow or fingerprint a visitor. */
+const IDENTIFYING_KEYS = [
+  'ip',
+  'ipAddress',
+  'ua',
+  'userAgent',
+  'visitorId',
+  'sessionId',
+  'clientId',
+  'cid',
+  'uid',
+  'email',
+  'referrer',
+  'query',
+  'text',
+  'question',
+  'lang',
+  'language',
+  'timezone',
+  'tz',
+  'screen',
+  'fingerprint',
+  'cookie',
+];
+
+const FATAL_ERROR_SIGNATURES = [
+  'Maximum update depth exceeded',
+  'Minified React error #185',
+  'getServerSnapshot should be cached',
+  'Minified React error #425',
+  'Minified React error #422',
+  'Text content does not match',
+  'Text content did not match',
+];
+
+/** The clause that must appear in the rendered colophon, verbatim. */
+const CANONICAL_COLOPHON_CLAUSE =
+  'measured on this origin only: dwell, scroll depth, drop-off, carousel depth, ' +
+  'chatbot sessions and topics, avatar plays and completion, and which path reached ' +
+  'a conversation · never collected: cookies, identifiers, fingerprints, IP addresses, ' +
+  'or anything you type';
+
+/** Wording the page may no longer use once a collector exists. */
+const LEGACY_CLAIM = 'no analytics, no trackers, no cookies';
+
+function collectKeysDeep(value: unknown, acc: Set<string> = new Set()): Set<string> {
+  if (Array.isArray(value)) {
+    for (const v of value) collectKeysDeep(v, acc);
+  } else if (value && typeof value === 'object') {
+    for (const [k, v] of Object.entries(value as Record<string, unknown>)) {
+      acc.add(k);
+      collectKeysDeep(v, acc);
+    }
+  }
+  return acc;
+}
+
+/**
+ * A full visit: load, settle, walk every section, drive the vitrine rail, run to
+ * the bottom and back. This is the shape of visit the telemetry is supposed to
+ * describe, so it is also the shape of visit the guards run against.
+ */
+async function fullVisit(page: Page) {
+  await page.goto('/', { waitUntil: 'load' });
+  await page
+    .waitForFunction(() => document.body.classList.contains('page-ready'), null, { timeout: 20000 })
+    .catch(() => {});
+
+  for (const selector of SECTIONS) {
+    const section = page.locator(selector);
+    if ((await section.count()) === 0) continue;
+    await section.scrollIntoViewIfNeeded().catch(() => {});
+    await page.waitForTimeout(700);
+  }
+
+  const rail = page.locator('#vitrine ol').first();
+  if ((await rail.count()) > 0) {
+    await rail.evaluate((el) => el.scrollTo({ left: el.scrollWidth, behavior: 'instant' as ScrollBehavior }));
+    await page.waitForTimeout(600);
+    await rail.evaluate((el) => el.scrollTo({ left: 0, behavior: 'instant' as ScrollBehavior }));
+    await page.waitForTimeout(600);
+  }
+
+  await page.evaluate(() => window.scrollTo(0, document.body.scrollHeight));
+  await page.waitForTimeout(900);
+  await page.evaluate(() => window.scrollTo(0, 0));
+  await page.waitForTimeout(600);
+}
+
+test.describe('TC-TELEMETRY-FIRST-PARTY: R-87 collection, R-183 self-claim', () => {
+  test.describe.configure({ timeout: 150000 });
+
+  test('TEL-FP-01: instrumenting the page still fires ZERO third-party requests', async ({ page }) => {
+    const requests: Request[] = [];
+    page.on('request', (r) => requests.push(r));
+
+    await fullVisit(page);
+
+    const pageOrigin = new URL(page.url()).origin;
+    const foreign = requests
+      .map((r) => r.url())
+      .filter((u) => u.startsWith('http'))
+      .filter((u) => new URL(u).origin !== pageOrigin);
+
+    expect(
+      foreign,
+      `The site's own claim is 0 third-party requests. These left the origin:\n${foreign.join('\n')}`,
+    ).toEqual([]);
+    // A visit that made no requests at all would pass the check above vacuously.
+    expect(requests.length, 'no requests were observed at all — the trace is not evidence of anything').toBeGreaterThan(5);
+  });
+
+  test('TEL-FP-02: the visit sends at least one beacon to the same-origin collector', async ({ page }) => {
+    const beacons: Request[] = [];
+    page.on('request', (r) => {
+      if (new URL(r.url()).pathname === COLLECTOR_PATH) beacons.push(r);
+    });
+
+    await fullVisit(page);
+
+    expect(
+      beacons.length,
+      `No request to ${COLLECTOR_PATH} was observed during a full visit. R-87 requires dwell, ` +
+        `scroll depth, drop-off, carousel depth, chatbot sessions and topics, avatar plays and ` +
+        `completion, and conversion to be measured; nothing was sent.`,
+    ).toBeGreaterThan(0);
+
+    const pageOrigin = new URL(page.url()).origin;
+    for (const b of beacons) {
+      expect(new URL(b.url()).origin, 'the beacon left the origin').toBe(pageOrigin);
+      expect(b.method(), 'the beacon must POST — a GET would put the payload in a shared log line').toBe('POST');
+    }
+  });
+
+  test('TEL-FP-03: the beacon payload carries only {at, name, section, value} and no identifier', async ({ page }) => {
+    const bodies: unknown[] = [];
+    page.on('request', (r) => {
+      if (new URL(r.url()).pathname !== COLLECTOR_PATH) return;
+      const raw = r.postData();
+      if (!raw) return;
+      try {
+        bodies.push(JSON.parse(raw));
+      } catch {
+        bodies.push({ __unparseable: raw });
+      }
+    });
+
+    await fullVisit(page);
+
+    expect(bodies.length, `no beacon payload was captured at ${COLLECTOR_PATH}`).toBeGreaterThan(0);
+
+    for (const body of bodies) {
+      const envelope = body as { events?: Array<Record<string, unknown>> };
+      expect(Array.isArray(envelope.events), 'the beacon envelope must be {events: [...]}').toBe(true);
+      for (const ev of envelope.events ?? []) {
+        expect(Object.keys(ev).sort()).toEqual(ALLOWED_EVENT_KEYS);
+      }
+      const leaked = Array.from(collectKeysDeep(body)).filter((k) => IDENTIFYING_KEYS.includes(k));
+      expect(leaked, `the beacon carries identifying keys: ${leaked.join(', ')}`).toEqual([]);
+    }
+  });
+
+  test('TEL-FP-04: after a full visit there are no cookies and no identifier in storage', async ({ page, context }) => {
+    await fullVisit(page);
+
+    const cookies = await context.cookies();
+    expect(cookies.map((c) => c.name), `cookies were set: ${cookies.map((c) => c.name).join(', ')}`).toEqual([]);
+
+    const inline = await page.evaluate(() => document.cookie);
+    expect(inline, 'document.cookie is not empty').toBe('');
+
+    const storage = await page.evaluate(() => ({
+      local: Object.keys(window.localStorage),
+      session: Object.keys(window.sessionStorage),
+    }));
+    // The only storage key the audited baseline had was the error-boundary reload
+    // guard in app/error.tsx, and it only ever exists after a crash.
+    expect(storage.local, `localStorage keys: ${storage.local.join(', ')}`).toEqual([]);
+    expect(storage.session.filter((k) => k !== 'fm-error-reload'), `sessionStorage keys: ${storage.session.join(', ')}`).toEqual([]);
+  });
+
+  test('TEL-FP-05: no consent wall, banner or preference dialog exists', async ({ page }) => {
+    await fullVisit(page);
+    const text = (await page.locator('body').innerText()).toLowerCase();
+    for (const phrase of ['we use cookies', 'accept cookies', 'cookie policy', 'accept all', 'reject all', 'manage preferences']) {
+      expect(text, `a consent wall phrase is on the page: "${phrase}"`).not.toContain(phrase);
+    }
+  });
+
+  test('TEL-FP-06 (R-183): the rendered colophon states what is measured and no longer claims "no analytics"', async ({ page }) => {
+    await page.goto('/', { waitUntil: 'load' });
+    const listen = page.locator('#listen');
+    await listen.scrollIntoViewIfNeeded();
+    const text = await listen.innerText();
+
+    expect(
+      text,
+      'the page still tells the visitor it collects nothing, while a collector is deployed — R-183',
+    ).not.toContain(LEGACY_CLAIM);
+    expect(
+      text,
+      `the reconciled measurement clause is not on the page. Required verbatim:\n${CANONICAL_COLOPHON_CLAUSE}`,
+    ).toContain(CANONICAL_COLOPHON_CLAUSE);
+  });
+
+  test('TEL-FP-07: the telemetry store never trips the 2026-07-09 render loop (React #185 / #425)', async ({ page }) => {
+    const pageErrors: string[] = [];
+    const consoleErrors: string[] = [];
+    page.on('pageerror', (err) => pageErrors.push(err.message));
+    page.on('console', (msg) => {
+      if (msg.type() === 'error') consoleErrors.push(msg.text());
+    });
+
+    await fullVisit(page);
+    // The outage's window was hydration plus a busy page; sit in it deliberately.
+    await page.evaluate(() => window.scrollTo(0, document.body.scrollHeight / 2));
+    await page.waitForTimeout(4000);
+
+    const fatal = [...pageErrors, ...consoleErrors].filter((m) =>
+      FATAL_ERROR_SIGNATURES.some((sig) => m.includes(sig)),
+    );
+    expect(fatal, `The telemetry store reintroduced the outage signature:\n${fatal.join('\n')}`).toHaveLength(0);
+
+    const body = await page.locator('body').innerText();
+    expect(body, 'the root error boundary replaced the page').not.toContain('Something went wrong');
+    await expect(page.locator('main')).toHaveCount(1);
+    await expect(page.locator('#hero')).toContainText('Vikram');
+  });
+
+  test('TEL-FP-08 (R-88): the shipped aggregate names the sections the loop must reopen', async ({ page }) => {
+    const res = await page.request.get('/data/telemetry-aggregate.json');
+    expect(
+      res.status(),
+      'the R-88 aggregate is not published with the site, so nothing can reopen an under-performing section',
+    ).toBe(200);
+
+    const agg = (await res.json()) as {
+      sections?: Record<string, Record<string, { kind?: string; provenance?: { retrievedAt?: string } }>>;
+      underperforming?: string[];
+    };
+    expect(Array.isArray(agg.underperforming), 'the aggregate carries no `underperforming` verdict').toBe(true);
+
+    const sections = agg.sections ?? {};
+    expect(Object.keys(sections).sort()).toEqual(['about', 'experience', 'hero', 'listen', 'skills', 'vitrine']);
+    for (const [id, metrics] of Object.entries(sections)) {
+      for (const [metric, field] of Object.entries(metrics)) {
+        expect(['sourced', 'not-observable'], `${id}.${metric} has kind "${field.kind}"`).toContain(field.kind);
+        const at = field.provenance?.retrievedAt ?? '';
+        expect(Number.isFinite(Date.parse(at)), `${id}.${metric} has no parseable retrievedAt (got "${at}")`).toBe(true);
+      }
+    }
+  });
+});
diff --git a/tests/telemetry/collector.contract.mjs b/tests/telemetry/collector.contract.mjs
