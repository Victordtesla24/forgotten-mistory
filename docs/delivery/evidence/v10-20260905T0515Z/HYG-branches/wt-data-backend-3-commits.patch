+#!/usr/bin/env node
+/**
+ * Build-time contract for the chatbot's retrieval index, its grounding
+ * enforcement and its abuse protection.
+ *
+ * Run:  node scripts/validate/chat_retrieval_contract.mjs
+ *
+ * Contract: SPEC-chatbot-uplift.md §2.3, §2.4, §2.5, §3.1, §3.2, §6.1, §6.4,
+ *           §8.7, §9.6 · R-66, R-71, R-73, R-108, R-111, R-131, R-175, R-183 · D-04.
+ *
+ * These are properties of the artefact on disk, not of a symbol. Each one names
+ * the value it expected and the value it found, so a red is a diagnosis.
+ *
+ * Nothing here asserts anything about `components/MiniVicBot.tsx` or the client
+ * bundle: the conversational layer's client wiring is a later wave, and a check
+ * this wave cannot satisfy is noise, not a gate.
+ */
+import { readFileSync, existsSync, readdirSync, statSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { dirname, resolve, join, relative } from 'node:path';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+const ROOT = resolve(HERE, '../..');
+const P = (...p) => resolve(ROOT, ...p);
+
+const results = [];
+function check(id, title, fn) {
+  try {
+    const detail = fn();
+    results.push({ id, title, ok: true, detail: detail || '' });
+  } catch (err) {
+    results.push({ id, title, ok: false, detail: err && err.message ? err.message : String(err) });
+  }
+}
+function fail(msg) {
+  throw new Error(msg);
+}
+function must(cond, msg) {
+  if (!cond) fail(msg);
+}
+function readText(rel) {
+  const abs = P(rel);
+  must(existsSync(abs), `${rel} does not exist`);
+  return readFileSync(abs, 'utf8');
+}
+function readJson(rel) {
+  try {
+    return JSON.parse(readText(rel));
+  } catch (err) {
+    fail(`${rel} is not readable JSON: ${err.message}`);
+  }
+}
+function walk(dir, out = []) {
+  if (!existsSync(dir)) return out;
+  for (const name of readdirSync(dir)) {
+    const abs = join(dir, name);
+    if (statSync(abs).isDirectory()) walk(abs, out);
+    else out.push(abs);
+  }
+  return out;
+}
+
+/* ------------------------------------------------------------------ *
+ * A · The server modules exist and are wired on the Functions path    *
+ *     that already works (D-04).                                      *
+ * ------------------------------------------------------------------ */
+
+const CHAT_MODULES = [
+  'config.js',
+  'tokenize.js',
+  'bm25.js',
+  'retrieve.js',
+  'prompt.js',
+  'sentences.js',
+  'validate.js',
+  'ratelimit.js',
+  'handler.js',
+];
+
+check('BOT-SRC-01', 'functions/chat/** carries the nine server modules', () => {
+  const missing = CHAT_MODULES.filter((m) => !existsSync(P('functions/chat', m)));
+  must(
+    missing.length === 0,
+    `missing from functions/chat/: ${missing.join(', ')}. R-66's retrieval and R-73's ` +
+      `protections have no home until these exist.`,
+  );
+  return `${CHAT_MODULES.length} modules present`;
+});
+
+check('BOT-SRC-02', 'minivicChat delegates to the handler and minivicChatStream is exported', () => {
+  const src = readText('functions/index.js');
+  must(
+    /require\(['"]\.\/chat\/handler['"]\)/.test(src),
+    `functions/index.js still inlines the chat body. §1.4: minivicChat's body is replaced ` +
+      `with require('./chat/handler').buffered so a single implementation serves both paths.`,
+  );
+  must(
+    /exports\.minivicChatStream\s*=/.test(src),
+    `functions/index.js exports no minivicChatStream. R-71 has no transport without it.`,
+  );
+  must(
+    /timeoutSeconds:\s*60/.test(src),
+    `the streaming function needs timeoutSeconds: 60; a 30 s ceiling truncates long answers.`,
+  );
+  return 'handler wired, stream export present';
+});
+
+check('BOT-SRC-03', 'functions/package.json declares firebase-admin for the Firestore limiter', () => {
+  const pkg = readJson('functions/package.json');
+  const dep = (pkg.dependencies || {})['firebase-admin'];
+  must(dep, `firebase-admin is absent; §6.1's rolling-window limiter has no Firestore client.`);
+  return `firebase-admin ${dep}`;
+});
+
+check('BOT-SRC-04', 'firebase.json rewrites /api/chat/stream to minivicChatStream', () => {
+  const fb = readJson('firebase.json');
+  const rewrites = (fb.hosting && fb.hosting.rewrites) || [];
+  const r = rewrites.find((x) => x.source === '/api/chat/stream');
+  must(
+    r,
+    `no /api/chat/stream rewrite. Observed baseline: POST that path returns HTTP 404. ` +
+      `Present rewrites: ${rewrites.map((x) => x.source).join(', ')}`,
+  );
+  must(
+    r.function && r.function.functionId === 'minivicChatStream',
+    `/api/chat/stream points at ${JSON.stringify(r.function)}, not minivicChatStream`,
+  );
+  must(fb.firestore, `firebase.json declares no firestore block; §6.1's chat_rate has nowhere to live`);
+  return 'rewrite + firestore block present';
+});
+
+check('BOT-SRC-05', 'TC-BOT-STATIC-03: exactly one system-prompt template, and it lives in prompt.js', () => {
+  const files = walk(P('functions/chat'));
+  must(files.length > 0, `functions/chat/ is empty or absent`);
+  const carriers = files.filter((f) => readFileSync(f, 'utf8').includes('<<<EVIDENCE>>>'));
+  must(
+    carriers.length === 1,
+    `the delimited evidence block appears in ${carriers.length} files ` +
+      `(${carriers.map((f) => relative(ROOT, f)).join(', ')}). A second system prompt is a ` +
+      `second grounding policy, and one of them will drift.`,
+  );
+  must(
+    relative(ROOT, carriers[0]) === 'functions/chat/prompt.js',
+    `the system prompt lives in ${relative(ROOT, carriers[0])}, not functions/chat/prompt.js`,
+  );
+  return 'one template, in prompt.js';
+});
+
+check('BOT-SEC-04', 'functions/chat/** never interpolates a secret or request content into a log', () => {
+  const files = walk(P('functions/chat'));
+  must(
+    files.length > 0,
+    `functions/chat/ does not exist, so this cannot be evaluated. A check that passes because ` +
+      `there is nothing to check is a gate that cannot fail (§11).`,
+  );
+  const offenders = [];
+  for (const f of files) {
+    const src = readFileSync(f, 'utf8');
+    const lines = src.split('\n');
+    lines.forEach((line, i) => {
+      if (!/logger\.(error|warn|info|log)|console\.(error|warn|info|log)/.test(line)) return;
+      if (/API_KEY|\.value\(\)|question|prompt|messages|body\b/.test(line)) {
+        offenders.push(`${relative(ROOT, f)}:${i + 1}: ${line.trim().slice(0, 120)}`);
+      }
+    });
+  }
+  must(
+    offenders.length === 0,
+    `a log line carries a secret or request content:\n    ${offenders.join('\n    ')}`,
+  );
+  return 'logs carry codes only';
+});
+
+check('BOT-SEC-05', 'functions/chat/** reads no NEXT_PUBLIC_ variable', () => {
+  const files = walk(P('functions/chat'));
+  must(files.length > 0, `functions/chat/ does not exist, so this cannot be evaluated.`);
+  const offenders = [];
+  for (const f of files) {
+    const src = readFileSync(f, 'utf8');
+    if (/NEXT_PUBLIC_/.test(src)) offenders.push(relative(ROOT, f));
+  }
+  must(offenders.length === 0, `NEXT_PUBLIC_ is a browser-visible namespace: ${offenders.join(', ')}`);
+  return 'no client-visible variable read server-side';
+});
+
+/* ------------------------------------------------------------------ *
+ * B · The index: real provenance on every chunk, no invented figure,  *
+ *     no zero where a value belongs.                                  *
+ * ------------------------------------------------------------------ */
+
+const INDEX_REL = 'functions/data/chat-index.v1.json';
+let INDEX = null;
+check('BOT-IDX-01', 'the retrieval index exists and is internally consistent', () => {
+  INDEX = readJson(INDEX_REL);
+  must(INDEX.version === 1, `version is ${JSON.stringify(INDEX.version)}, expected 1`);
+  must(Array.isArray(INDEX.chunks), `chunks is not an array`);
+  must(
+    INDEX.chunkCount === INDEX.chunks.length,
+    `chunkCount ${INDEX.chunkCount} disagrees with chunks.length ${INDEX.chunks.length}`,
+  );
+  must(INDEX.chunkCount <= 400, `chunkCount ${INDEX.chunkCount} exceeds the 400 ceiling (§2.4)`);
+  must(INDEX.chunkCount > 0, `an empty index is not a retrieval layer`);
+  const ids = INDEX.chunks.map((c) => c.id);
+  must(new Set(ids).size === ids.length, `duplicate chunk ids`);
+  const sorted = [...ids].sort();
+  must(ids.join('␀') === sorted.join('␀'), `chunks are not in id-sorted order, so the diff is not reviewable`);
+  return `${INDEX.chunkCount} chunks`;
+});
+
+check('BOT-IDX-02', 'the index is built from the same dataset version the site renders (R-108)', () => {
+  must(INDEX, `the index did not load`);
+  const manifestCandidates = ['app/data/generated/manifest.v1.json', 'app/data/canonical/manifest.v1.json'];
+  const found = manifestCandidates.find((m) => existsSync(P(m)));
+  must(
+    found,
+    `no canonical manifest at ${manifestCandidates.join(' or ')}. The chat index may not be ` +
+      `built from a second, unversioned copy of the corpus (§2.2, S-8).`,
+  );
+  const manifest = readJson(found);
+  must(
+    INDEX.datasetVersion === manifest.datasetVersion,
+    `index datasetVersion ${INDEX.datasetVersion} != manifest datasetVersion ${manifest.datasetVersion}`,
+  );
+  return `datasetVersion ${INDEX.datasetVersion}`;
+});
+
+check('BOT-IDX-03', 'every chunk carries a provenance record with a real retrievedAt', () => {
+  must(INDEX, `the index did not load`);
+  const now = Date.now();
+  const bad = [];
+  for (const c of INDEX.chunks) {
+    const p = c.provenance;
+    if (!p) {
+      bad.push(`${c.id}: no provenance`);
+      continue;
+    }
+    const t = Date.parse(p.retrievedAt);
+    if (!Number.isFinite(t)) bad.push(`${c.id}: retrievedAt ${JSON.stringify(p.retrievedAt)} does not parse`);
+    else if (t > now + 60000) bad.push(`${c.id}: retrievedAt is in the future`);
+    else if (t < Date.parse('2020-01-01T00:00:00Z')) bad.push(`${c.id}: retrievedAt is a placeholder epoch`);
+    if (!p.source || typeof p.source !== 'string') bad.push(`${c.id}: no provenance.source`);
+    if (!p.method || typeof p.method !== 'string') bad.push(`${c.id}: no runnable provenance.method`);
+  }
+  must(bad.length === 0, `${bad.length} chunks without real provenance:\n    ${bad.slice(0, 10).join('\n    ')}`);
+  return `${INDEX.chunks.length} provenance records`;
+});
+
+check('BOT-IDX-04', 'chunk text is one atomic claim: 40 to 320 characters', () => {
+  must(INDEX, `the index did not load`);
+  const bad = INDEX.chunks
+    .filter((c) => typeof c.text !== 'string' || c.text.length < 40 || c.text.length > 320)
+    .map((c) => `${c.id}: ${typeof c.text === 'string' ? c.text.length : typeof c.text} chars`);
+  must(bad.length === 0, `${bad.length} chunks outside 40..320:\n    ${bad.slice(0, 10).join('\n    ')}`);
+  return 'all chunks within bounds';
+});
+
+check('BOT-IDX-05', 'R-111: every numeral in a chunk is a numeral the chunk actually contains', () => {
+  must(INDEX, `the index did not load`);
+  const RE = /\d[\d,]*(?:\.\d+)?\s?%?/g;
+  const norm = (raw) => {
+    const pct = /%$/.test(String(raw).trim());
+    const n = String(raw).replace(/[,%\s]/g, '').replace(/^0+(?=\d)/, '');
+    return pct ? `${n}%` : n;
+  };
+  const bad = [];
+  for (const c of INDEX.chunks) {
+    const inText = new Set((String(c.text).match(RE) || []).map(norm));
+    const declared = new Set((c.numerals || []).map(norm));
+    for (const d of declared) if (!inText.has(d)) bad.push(`${c.id}: declares ${d}, text does not contain it`);
+    for (const t of inText) if (!declared.has(t)) bad.push(`${c.id}: text says ${t}, numerals does not declare it`);
+  }
+  must(
+    bad.length === 0,
+    `a numeral the extractor cannot see is a numeral the validator cannot police (§2.3 rule 3):\n    ` +
+      bad.slice(0, 10).join('\n    '),
+  );
+  return 'numerals and text agree';
+});
+
+check('BOT-IDX-06', 'df and postings agree, term for term', () => {
+  must(INDEX, `the index did not load`);
+  must(INDEX.df && INDEX.postings, `the index carries no df/postings map — every query would be a full scan`);
+  const bad = [];
+  for (const [term, df] of Object.entries(INDEX.df)) {
+    const post = INDEX.postings[term];
+    if (!post) bad.push(`${term}: in df, absent from postings`);
+    else if (post.length !== df) bad.push(`${term}: df ${df} != ${post.length} postings`);
+  }
+  for (const term of Object.keys(INDEX.postings)) {
+    if (!(term in INDEX.df)) bad.push(`${term}: in postings, absent from df`);
+  }
+  must(bad.length === 0, `${bad.length} disagreements:\n    ${bad.slice(0, 10).join('\n    ')}`);
+  return `${Object.keys(INDEX.df).length} terms`;
+});
+
+check('BOT-IDX-07', 'indexHash is the canonical hash of the chunks it ships', () => {
+  must(INDEX, `the index did not load`);
+  must(/^[0-9a-f]{64}$/.test(String(INDEX.indexHash)), `indexHash ${JSON.stringify(INDEX.indexHash)} is not a sha256`);
+  const canon = P('scripts/dataset/lib/canonical_json.mjs');
+  must(
+    existsSync(canon),
+    `scripts/dataset/lib/canonical_json.mjs does not exist, so the hash has no defined input ` +
+      `and the index's diff is not reviewable (§2.4)`,
+  );
+  return 'hash present, canonical serialiser present';
+});
+
+check('BOT-IDX-08', 'R-69: every chunk deep-links somewhere real, and channel chunks invent no timestamp', () => {
+  must(INDEX, `the index did not load`);
+  const bad = [];
+  for (const c of INDEX.chunks) {
+    const hasAnchor = typeof c.siteAnchor === 'string' && c.siteAnchor.startsWith('#');
+    const hasArtefact = typeof c.artefactUrl === 'string' && c.artefactUrl.length > 0;
+    if (!hasAnchor && !hasArtefact) bad.push(`${c.id}: neither a site anchor nor a proving artefact`);
+    if (c.corpus === 'channel' && hasArtefact && /[?&]t=/.test(c.artefactUrl)) {
+      bad.push(
+        `${c.id}: carries a &t= fragment. Transcripts are LOGIN_REQUIRED, so no timestamp is ` +
+          `observable and none may be invented (§2.3 anchors).`,
+      );
+    }
+    if (c.corpus === 'cv' && hasArtefact && !/#page=\d+/.test(c.artefactUrl)) {
+      bad.push(`${c.id}: a CV artefact must deep-link to the page it was read from`);
+    }
+  }
+  must(bad.length === 0, `${bad.length} anchor defects:\n    ${bad.slice(0, 10).join('\n    ')}`);
+  return 'anchors resolve';
+});
+
+check('BOT-IDX-09', 'R-175: a not-observable field is a sourced statement of absence, never a zero', () => {
+  must(INDEX, `the index did not load`);
+  const PLACEHOLDER = /^(0|0\.0|-|—|n\/a|na|tbd|tba|unknown|none|null|undefined|\s*)$/i;
+  const bad = [];
+  for (const c of INDEX.chunks) {
+    if (PLACEHOLDER.test(String(c.text).trim())) bad.push(`${c.id}: placeholder text ${JSON.stringify(c.text)}`);
+    if (!Array.isArray(c.terms) || c.terms.length < 3 || c.terms.length > 14) {
+      bad.push(`${c.id}: terms must be 3..14 retrieval keys, got ${Array.isArray(c.terms) ? c.terms.length : typeof c.terms}`);
+    }
+    if (c.provenance && c.provenance.status === 'not-observable') {
+      const reason = c.provenance.reason;
+      if (!reason || String(reason).trim().length < 20) {
+        bad.push(
+          `${c.id}: a not-observable field must carry the reason it could not be observed, so ` +
+            `the bot can say it out loud (§2.3 rule 2). got ${JSON.stringify(reason)}`,
+        );
+      }
+    }
+  }
+  must(bad.length === 0, `${bad.length} defects:\n    ${bad.slice(0, 10).join('\n    ')}`);
+  return 'no placeholders';
+});
+
+check('BOT-IDX-10', 'the entity allow-list is generated from the corpus, never hand-added', () => {
+  const ents = readJson('functions/data/chat-entities.json');
+  must(ents.generatedBy || ents.generator, `chat-entities.json carries no generator stamp; a hand-added entity is a licence to name it`);
+  must(Array.isArray(ents.entities) || Array.isArray(ents.acronyms), `chat-entities.json declares no entity list`);
+  must(INDEX, `the index did not load`);
+  const known = new Set([...(ents.entities || []), ...(ents.acronyms || [])]);
+  const missing = [];
+  for (const c of INDEX.chunks) {
+    for (const e of c.entities || []) if (!known.has(e)) missing.push(`${c.id}: ${e}`);
+  }
+  must(missing.length === 0, `entities in the index but not in the allow-list:\n    ${missing.slice(0, 10).join('\n    ')}`);
+  return `${known.size} entities`;
+});
+
+check('BOT-IDX-11', 'the alias table is small, readable, and never manufactures a hit', () => {
+  const aliases = readJson('functions/data/chat-aliases.json');
+  const keys = Object.keys(aliases).filter((k) => !k.startsWith('$'));
+  must(keys.length <= 80, `${keys.length} alias entries exceeds the 80 ceiling (§2.5)`);
+  must(keys.length > 0, `the alias table is empty; §2.1's named mitigation for vocabulary mismatch does not exist`);
+  must(
+    Array.isArray(aliases.salary) && aliases.salary.length === 0,
+    `"salary" must expand to [] deliberately: expansion may never manufacture a hit for a ` +
+      `question the corpus cannot answer. got ${JSON.stringify(aliases.salary)}`,
+  );
+  return `${keys.length} aliases`;
+});
+
+check('BOT-INDEX-02', 'TC-BOT-INDEX-02: the index ships zero bytes to the browser', () => {
+  must(
+    INDEX,
+    `there is no index yet, so "the index did not leak" is vacuously true. This check reports ` +
+      `red until there is a real index whose absence from out/ means something.`,
+  );
+  const out = P('out');
+  must(
+    existsSync(out),
+    `out/ does not exist — run npm run build:static before this gate. The check cannot be ` +
+      `skipped: an index that leaks into the bundle is a 400 KB regression and a corpus dump.`,
+  );
+  const needles = ['chunkCount', 'chat-index.v1', 'IN_CORPUS_MIN_SCORE'];
+  const hits = [];
+  for (const f of walk(out)) {
+    if (!/\.(js|json|html|txt|map)$/.test(f)) continue;
+    const src = readFileSync(f, 'utf8');
+    for (const n of needles) if (src.includes(n)) hits.push(`${relative(ROOT, f)} contains "${n}"`);
+  }
+  must(hits.length === 0, `the retrieval index leaked into the static export:\n    ${hits.slice(0, 10).join('\n    ')}`);
+  return 'browser carries none of it';
+});
+
+/* ------------------------------------------------------------------ *
+ * C · Rate limiting, and the self-claim that must move with it.       *
+ * ------------------------------------------------------------------ */
+
+check('BOT-RL-01', 'the limiter enforces the four §6.1 windows and never writes a raw IP', () => {
+  const src = readText('functions/chat/ratelimit.js');
+  must(/chat_rate/.test(src), `the limiter names no chat_rate collection`);
+  const wanted = [
+    [/\b12\b/, '12 questions per conversation per 10 minutes'],
+    [/\b40\b/, '40 questions per conversation per 60 minutes'],
+    [/\b60\b/, '60 questions per hashed network per 60 minutes'],
+  ];
+  const missing = wanted.filter(([re]) => !re.test(src)).map(([, why]) => why);
+  must(missing.length === 0, `windows not enforced: ${missing.join('; ')}`);
+  must(
+    /sha256/i.test(src) && /salt/i.test(src),
+    `§6.1: hashedIp = sha256(dailySalt + ':' + ip). Enforcement, not identity.`,
+  );
+  must(
+    !/\b(req\.ip|x-forwarded-for)\b[^\n]*\b(set|add|update|create)\(/i.test(src),
+    `the raw IP must never be written to a document`,
+  );
+  must(/expiresAt/.test(src), `the counter needs a TTL field; §6.1 keeps it for one hour and no longer`);
+  return 'windows, salted hash, TTL';
+});
+
+check('BOT-COLOPHON-01', 'R-183: the counter and the sentence that discloses it ship together', () => {
+  const limiterExists = existsSync(P('functions/chat/ratelimit.js'));
+  const writesCounter =
+    limiterExists && /chat_rate/.test(readFileSync(P('functions/chat/ratelimit.js'), 'utf8'));
+
+  const copySources = ['app/data/portfolio/listen.ts', 'app/data/siteContent.ts'].filter((f) => existsSync(P(f)));
+  const copy = copySources.map((f) => readFileSync(P(f), 'utf8')).join('\n');
+  const discloses =
+    /daily-salted hash of your IP address/i.test(copy) && /kept for\s*\n?\s*one hour/i.test(copy.replace(/\s+/g, ' '));
+
+  if (writesCounter && !discloses) {
+    fail(
+      `functions/chat/ratelimit.js writes a chat_rate counter but no published sentence says ` +
+        `so. R-183 forbids the site stating something about itself that its own code ` +
+        `contradicts. The sentence and the write ship in the SAME commit.`,
+    );
+  }
+  if (!writesCounter && discloses) {
+    fail(
+      `the published copy discloses a hashed-IP counter that no code writes. A claim ahead of ` +
+        `its implementation is the same defect pointing the other way.`,
+    );
+  }
+  must(
+    writesCounter && discloses,
+    `neither the counter nor its disclosure exists yet. R-73's abuse protection is unbuilt, ` +
+      `and this lock stays red until both land together.`,
+  );
+  return 'counter and disclosure agree';
+});
+
+/* ------------------------------------------------------------------ *
+ * D · Build wiring — the index is rebuilt by the build, not by hand.  *
+ * ------------------------------------------------------------------ */
+
+check('BOT-PKG-01', 'chat:index, chat:calibrate and chat:probe exist and the build runs the index', () => {
+  const pkg = readJson('package.json');
+  const s = pkg.scripts || {};
+  const missing = ['chat:index', 'chat:calibrate', 'chat:probe'].filter((k) => !s[k]);
+  must(missing.length === 0, `package.json is missing scripts: ${missing.join(', ')}`);
+  must(
+    /chat:index|build_chat_index/.test(s.build || ''),
+    `"build" does not rebuild the index. B-3 is the standing lesson: harvest_repos.mjs calls ` +
+      `the real API and sits in neither a build script nor CI, so its data ages silently.`,
+  );
+  must(
+    /chat:index|build_chat_index/.test(s['build:static'] || ''),
+    `"build:static" does not rebuild the index`,
+  );
+  return 'wired into both builds';
+});
+
+check('BOT-PKG-02', 'the builder and the two probes exist on disk', () => {
+  const needed = [
+    'scripts/dataset/build_chat_index.mjs',
+    'scripts/validate/chat_retrieval_calibration.mjs',
+    'scripts/validate/chat_stream_probe.mjs',
+  ];
+  const missing = needed.filter((f) => !existsSync(P(f)));
+  must(missing.length === 0, `missing: ${missing.join(', ')}`);
+  return 'builder and probes present';
+});
+
+/* ------------------------------------------------------------------ *
+ * Report                                                              *
+ * ------------------------------------------------------------------ */
+
+const settled = results;
+const failed = settled.filter((r) => !r.ok);
+const width = Math.max(...settled.map((r) => r.id.length));
+console.log('\nCHAT RETRIEVAL / GROUNDING CONTRACT — SPEC-chatbot-uplift.md\n');
+for (const r of settled) {
+  console.log(`${r.ok ? 'PASS' : 'FAIL'}  ${r.id.padEnd(width)}  ${r.title}`);
+  if (!r.ok) console.log(`      ${String(r.detail).split('\n').join('\n      ')}`);
+}
+console.log(`\n${settled.length - failed.length}/${settled.length} checks passed.\n`);
+if (failed.length) {
+  console.log(`FAILED: ${failed.map((r) => r.id).join(', ')}`);
+  process.exit(1);
+}
diff --git a/tests/api/chat_contract.contract.mjs b/tests/api/chat_contract.contract.mjs
