{
  "name": "forgotten-mistory",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/fm/dev.mjs",
    "dev:raw": "rm -rf .next && NODE_ENV=development next dev -p 8080",
    "fmctl": "node scripts/fmctl",
    "test:fmctl": "node --test tests/fmctl.test.mjs",
    "build": "rm -rf .next && node scripts/build/build_stamp.mjs && node scripts/build/cv_fingerprint.mjs && NODE_ENV=production next build",
    "build:static": "rm -rf .next out && node scripts/build/build_stamp.mjs && node scripts/build/cv_fingerprint.mjs && NODE_ENV=production FIREBASE_STATIC_EXPORT=1 next build && node scripts/build/prune_static_export.mjs && node scripts/validate/built_output_secret_scan.mjs --dir out",
    "start": "next start",
    "lint": "next lint",
    "test": "playwright test",
    "test:e2e:bot": "RUN_BOT_E2E=1 playwright test tests/deployment_v2.spec.ts",
    "validate:phase01": "bash scripts/validate/phase01_stack.sh",
    "validate:phase02": "bash scripts/validate/phase02_lighthouse.sh",
    "validate:phase02:screenshots": "node scripts/validate/phase02_screenshots.mjs",
    "validate:phase03": "bash scripts/validate/phase03_design_tokens.sh",
    "validate:phase04": "bash scripts/validate/phase04_animation_fps.sh",
    "assets:hero": "node scripts/assets/generate_hero_formats.mjs",
    "validate:phase05": "bash scripts/validate/phase05_graphics_fidelity.sh",
    "validate:phase06": "bash scripts/validate/phase06_accessibility_seo.sh",
    "validate:phase07": "bash scripts/validate/phase07_llm_ttft.sh",
    "validate:phase08": "bash scripts/validate/phase08_tts_latency.sh",
    "validate:phase09": "bash scripts/validate/phase09_avatar_sync.sh",
    "validate:phase10": "bash scripts/validate/phase10_viseme_bridge.sh",
    "validate:phase11": "bash scripts/validate/phase11_compose_boot.sh",
    "validate:phase12": "bash scripts/validate/phase12_resource_constraints.sh",
    "validate:phase13": "bash scripts/validate/phase13_vps_provisioning.sh",
    "validate:phase14": "bash scripts/validate/phase14_npm_routing.sh",
    "validate:phase15": "bash scripts/validate/phase15_gateway_hardening.sh",
    "validate:phase16": "bash scripts/validate/phase16_cicd_workflow.sh",
    "validate:phase17": "bash scripts/validate/phase17_zero_downtime.sh",
    "validate:phase18": "bash scripts/validate/phase18_observability.sh",
    "validate:phase19": "bash scripts/validate/phase19_log_aggregation.sh",
    "validate:phase20": "bash scripts/validate/phase20_scaling_strategy.sh",
    "validate:phase21": "bash scripts/validate/phase21_realtime_pipeline.sh",
    "validate:provider-keys": "node scripts/validate/provider_api_keys.mjs",
    "validate:final": "bash scripts/validate/final_full_system_validation.sh",
    "validate:postprod": "bash scripts/testing/run_post_prod_validation.sh",
    "deploy": "node scripts/deploy.mjs",
    "test:realtime-pipeline": "node tests/test_realtime_pipeline.js",
    "validate:secrets": "node scripts/validate/built_output_secret_scan.mjs --dir out"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.2.4",
    "@react-three/drei": "9.122.0",
    "@react-three/fiber": "8.18.0",
    "@types/three": "0.165.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "11.18.2",
    "lucide-react": "0.344.0",
    "next": "^14.2.35",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwind-merge": "3.3.1",
    "three": "0.165.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "4.1.13",
    "@types/node": "20.11.24",
    "@types/react": "18.2.61",
    "@types/react-dom": "18.2.19",
    "autoprefixer": "10.4.17",
    "eslint": "8.57.0",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-react-hooks": "4.6.2",
    "pixelmatch": "^5.3.0",
    "playwright": "1.57.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "4.1.13",
    "typescript": "5.3.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "@next/eslint-plugin-next": {
      "glob": "^10.5.0"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
