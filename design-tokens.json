    "text": {
      "primary": { "value": "color(display-p3 0.93 0.95 0.99)" },
      "secondary": { "value": "color(display-p3 0.66 0.70 0.79)" },
      "muted": { "value": "color(display-p3 0.49 0.54 0.63)" }
    },
    "brand": {
      "primary": { "value": "color(display-p3 0.99 0.52 0.36)" },
      "accent": { "value": "color(display-p3 0.35 0.82 0.98)" },
      "success": { "value": "color(display-p3 0.43 0.90 0.67)" }
