{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "Forgotten Mistory Enterprise Tokens",
    "version": "1.0.0",
    "grid": "8pt",
    "fontFamily": "Inter Variable",
    "colorSpace": "display-p3"
  },
  "spacing": {
    "0": { "value": "0rem" },
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" }
  },
  "typography": {
    "display": { "value": { "fontFamily": "Inter Variable", "fontWeight": 700, "fontSize": "3.5rem", "lineHeight": 1.1 } },
    "h1": { "value": { "fontFamily": "Inter Variable", "fontWeight": 700, "fontSize": "2.5rem", "lineHeight": 1.2 } },
    "h2": { "value": { "fontFamily": "Inter Variable", "fontWeight": 600, "fontSize": "2rem", "lineHeight": 1.3 } },
    "body": { "value": { "fontFamily": "Inter Variable", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.6 } },
