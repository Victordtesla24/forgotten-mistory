{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "metadata": {
    "name": "Forgotten Mistory — Monochrome System",
    "version": "2.0.0",
    "grid": "8pt",
    "fontFamily": "Inter Variable",
    "note": "Monochromatic by mandate (docs/overhaul/SPEC.md §3.1). No hue; depth via light, blur, motion. The ONLY accent is a luminous cool-white."
  },
  "spacing": {
    "0": { "value": "0rem" },
    "1": { "value": "0.25rem" },
    "2": { "value": "0.5rem" },
    "3": { "value": "0.75rem" },
    "4": { "value": "1rem" },
    "6": { "value": "1.5rem" },
    "8": { "value": "2rem" },
    "10": { "value": "2.5rem" },
    "12": { "value": "3rem" },
    "16": { "value": "4rem" }
  },
  "typography": {
    "display": { "value": { "fontFamily": "Inter Variable", "fontWeight": 700, "fontSize": "3.5rem", "lineHeight": 1.05, "letterSpacing": "-0.02em" } },
    "h1": { "value": { "fontFamily": "Inter Variable", "fontWeight": 700, "fontSize": "2.5rem", "lineHeight": 1.1, "letterSpacing": "-0.015em" } },
    "h2": { "value": { "fontFamily": "Inter Variable", "fontWeight": 600, "fontSize": "2rem", "lineHeight": 1.2 } },
    "body": { "value": { "fontFamily": "Inter Variable", "fontWeight": 400, "fontSize": "1rem", "lineHeight": 1.6 } },
    "caption": { "value": { "fontFamily": "Inter Variable", "fontWeight": 500, "fontSize": "0.875rem", "lineHeight": 1.4 } }
  },
  "colors": {
    "ink": {
      "900": { "value": "#0A0B0D", "comment": "page background, near-black" },
      "800": { "value": "#121317", "comment": "raised surface" },
      "700": { "value": "#1B1D23", "comment": "card / panel" },
      "500": { "value": "#3A3D46", "comment": "border / hairline" }
    },
    "mist": {
      "400": { "value": "#8A8F9A", "comment": "secondary text" },
      "200": { "value": "#C9CDD6", "comment": "body text" }
    },
    "white": { "value": "#F4F6FA", "comment": "primary text / highlight" },
    "accent": { "value": "#E8EBF0", "comment": "THE only accent — luminous cool-white" },
    "steel": { "value": "#AEB6C2", "comment": "low-saturation glow tint, never large fills" }
  }
}
