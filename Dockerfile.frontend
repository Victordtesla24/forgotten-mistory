FROM node:20-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html
COPY --from=builder /app/.next /app/.next
COPY --from=builder /app/public /app/public
COPY --from=builder /app/package.json /app/package.json
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/next.config.js /app/next.config.js
COPY --from=builder /app/app /app/app
COPY --from=builder /app/components /app/components
COPY --from=builder /app/lib /app/lib
COPY --from=builder /app/tsconfig.json /app/tsconfig.json
COPY --from=builder /app/postcss.config.js /app/postcss.config.js
COPY --from=builder /app/tailwind.config.js /app/tailwind.config.js
COPY --from=builder /app/design-tokens.json /app/design-tokens.json
RUN printf 'server {\n  listen 3000;\n  location /health { return 200 "ok"; }\n  location / { proxy_pass http://127.0.0.1:3100; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 3000
CMD ["sh", "-c", "node /app/node_modules/next/dist/bin/next start -p 3100 & nginx -g 'daemon off;'"]
