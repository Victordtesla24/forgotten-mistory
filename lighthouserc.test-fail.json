{
  "ci": {
    "collect": {
      "url": ["http://127.0.0.1:3000/"],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "onlyCategories": ["performance"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", {"minScore": 0.95}],
        "first-contentful-paint": ["error", {"maxNumericValue": 100}],
        "largest-contentful-paint": ["error", {"maxNumericValue": 500}],
        "total-blocking-time": ["error", {"maxNumericValue": 50}],
        "cumulative-layout-shift": ["error", {"maxNumericValue": 0.001}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports-fail"
    }
  }
}
